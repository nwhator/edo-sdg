---
import Layout from '../../layouts/Layout.astro';
import AdminHeader from '../../components/admin/AdminHeader.astro';
import { FundingDirectory } from '../../components/portal/FundingDirectory';
import { fetchFundingPartners } from '../../lib/supabase';

const partners = await fetchFundingPartners();
---

<Layout
  title="Benin NGO Funding Directory (Executive Admin)"
  description="Restricted directory of NGOs and government partners in Benin City for women health and environmental sanitation drives."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-space-xl">
    <AdminHeader />

    <!-- Civic Header Banner -->
    <div class="p-space-lg rounded-2xl bg-surface-container-low border border-outline-variant/30 flex flex-col md:flex-row items-start md:items-center justify-between gap-space-lg">
      <div class="space-y-space-xs max-w-3xl">
        <div class="inline-flex items-center gap-space-xs px-space-sm py-0.5 rounded-full bg-primary-fixed text-on-primary-fixed font-label-sm text-label-sm uppercase tracking-wider font-bold">
          <span class="material-symbols-outlined text-[16px]">hub</span>
          Validated Civil Stakeholders
        </div>
        <h1 class="font-headline-md text-headline-md text-on-surface font-bold">
          Benin City NGO & Government Partner Registry
        </h1>
        <p class="font-body-md text-body-md text-on-surface-variant">
          Curated contact registry of institutional partners and civil organizations available for NYSC Egor LGA joint-interventions.
        </p>
      </div>

      <div class="flex items-center gap-space-md p-space-md rounded-xl bg-surface-container-lowest border border-outline-variant/30 shrink-0 shadow-xs">
        <div class="w-10 h-10 rounded-lg bg-surface-container flex items-center justify-center text-primary">
          <span class="material-symbols-outlined text-[24px]">corporate_fare</span>
        </div>
        <div>
          <span class="font-label-sm text-label-sm text-on-surface-variant block uppercase">Partner Registry</span>
          <span class="font-title-md text-title-md text-primary font-bold">{partners.length} Accredited</span>
        </div>
      </div>
    </div>

    <!-- Directory Component -->
    <FundingDirectory client:load initialPartners={partners} />
  </div>
</Layout>
