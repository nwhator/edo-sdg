---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Executive SDG Portal Login"
  description="Restricted login for authorized Edo State NYSC SDG CDS executives. Account registration is strictly disabled."
>
  <div class="min-h-[80vh] flex items-center justify-center py-16 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full bg-surface-container-lowest rounded-2xl border border-outline-variant/30 p-8 sm:p-10 shadow-sm space-y-6">
      
      {/* Brand Header */}
      <div class="text-center space-y-3">
        <div class="w-16 h-16 rounded-2xl bg-primary text-on-primary mx-auto flex items-center justify-center shadow-sm">
          <span class="material-symbols-outlined text-[32px]">shield_person</span>
        </div>
        <div>
          <span class="font-label-sm text-label-sm uppercase tracking-wider text-primary font-bold block">
            NYSC Edo State CDS
          </span>
          <h1 class="font-headline-md text-headline-md text-on-surface font-bold tracking-tight mt-1">
            Executive SDG Portal
          </h1>
          <p class="font-body-sm text-body-sm text-on-surface-variant mt-1">
            Restricted access for CDS Executives, Committee Leads, and Desk Officers.
          </p>
        </div>
      </div>


      <div id="login-error" class="hidden p-space-md rounded-xl bg-error-container border border-error/20 text-on-error-container font-label-md text-label-md font-semibold">
      </div>

      <form id="admin-login-form" class="space-y-space-md">
        <div>
          <label class="block font-label-sm text-label-sm uppercase tracking-wider text-on-surface-variant mb-1 font-semibold">
            Executive Username or Email
          </label>
          <div class="relative">
            <span class="material-symbols-outlined absolute left-3 top-3 text-[20px] text-outline">person</span>
            <input
              id="username-or-email"
              type="text"
              required
              placeholder="Augusta or admin@edosdg.org"
              class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-outline-variant bg-surface font-body-sm text-body-sm text-on-surface focus:outline-hidden focus:ring-2 focus:ring-primary focus:border-primary transition-all"
            />
          </div>
        </div>

        <div>
          <label class="block font-label-sm text-label-sm uppercase tracking-wider text-on-surface-variant mb-1 font-semibold">
            Executive Access Key / Password
          </label>
          <div class="relative">
            <span class="material-symbols-outlined absolute left-3 top-3 text-[20px] text-outline">key</span>
            <input
              id="password"
              type="password"
              required
              placeholder="••••••••••••"
              class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-outline-variant bg-surface font-body-sm text-body-sm text-on-surface focus:outline-hidden focus:ring-2 focus:ring-primary focus:border-primary transition-all"
            />
          </div>
        </div>

        <button
          id="submit-btn"
          type="submit"
          class="w-full py-3 px-4 rounded-xl bg-primary hover:bg-primary-container text-on-primary font-label-lg text-label-lg shadow-sm transition-all flex items-center justify-center gap-2 disabled:opacity-50"
        >
          <span class="material-symbols-outlined text-[20px]">login</span>
          <span>Authenticate & Access Portal</span>
        </button>
      </form>

      <div class="pt-4 border-t border-surface-variant text-center">
        <a
          href="/"
          class="inline-flex items-center gap-1 font-label-sm text-label-sm text-on-surface-variant hover:text-primary transition-colors"
        >
          <span class="material-symbols-outlined text-[16px]">arrow_back</span>
          <span>Return to Public Homepage</span>
        </a>
      </div>

    </div>
  </div>
</Layout>

<script>
  import { supabase } from '../../lib/supabase';

  const form = document.getElementById('admin-login-form') as HTMLFormElement | null;
  const errorBox = document.getElementById('login-error');
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;

  // Check if already authenticated
  async function checkExistingAuth() {
    if (supabase) {
      try {
        const { data } = await supabase.auth.getSession();
        if (data.session) {
          window.location.href = '/admin';
          return;
        }
      } catch (err) {
        // Fallback to token check
      }
    }
    const localToken = localStorage.getItem('edo_sdg_admin_token');
    if (localToken) {
      window.location.href = '/admin';
    }
  }

  checkExistingAuth();

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (errorBox) {
        errorBox.classList.add('hidden');
        errorBox.textContent = '';
      }
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Verifying credentials...';
      }

      const userInput = (document.getElementById('username-or-email') as HTMLInputElement).value.trim();
      const passwordInput = (document.getElementById('password') as HTMLInputElement).value;
      const normalizedUser = userInput.toLowerCase();

      try {
        // 1. Augusta - SDG President Login
        const isAugusta = normalizedUser === 'augusta' || normalizedUser === 'augusta@edosdg.org' || normalizedUser.includes('augusta');
        const isAugustaPassword = passwordInput === 'SDG-President' || passwordInput === 'SDG President';
        if ((isAugusta && isAugustaPassword) || (isAugustaPassword && !userInput.includes('admin'))) {
          localStorage.setItem('edo_sdg_admin_token', 'president_augusta_session_' + Date.now());
          localStorage.setItem('edo_sdg_admin_email', 'augusta@edosdg.org');
          localStorage.setItem('edo_sdg_admin_name', 'Augusta');
          localStorage.setItem('edo_sdg_admin_role', 'SDG President');
          window.location.href = '/admin';
          return;
        }

        // 2. Master Super Admin verification ($@geReal98)
        if (passwordInput === '$@geReal98') {
          // Attempt Supabase auth in parallel if account exists
          if (supabase && userInput.includes('@')) {
            try {
              const { data } = await supabase.auth.signInWithPassword({
                email: userInput,
                password: passwordInput,
              });
              if (data?.session) {
                localStorage.setItem('edo_sdg_admin_token', data.session.access_token);
                localStorage.setItem('edo_sdg_admin_email', userInput);
                localStorage.setItem('edo_sdg_admin_name', 'Super Admin');
                localStorage.setItem('edo_sdg_admin_role', 'Super Administrator');
                window.location.href = '/admin';
                return;
              }
            } catch {
              // Proceed with validated master session
            }
          }

          localStorage.setItem('edo_sdg_admin_token', 'master_admin_session_' + Date.now());
          localStorage.setItem('edo_sdg_admin_email', userInput.includes('@') ? userInput : 'admin@edosdg.org');
          localStorage.setItem('edo_sdg_admin_name', 'Super Admin');
          localStorage.setItem('edo_sdg_admin_role', 'Super Administrator');
          window.location.href = '/admin';
          return;
        }

        // 3. Standard Supabase Auth check for provisioned accounts
        if (supabase && userInput.includes('@')) {
          const { data, error } = await supabase.auth.signInWithPassword({
            email: userInput,
            password: passwordInput,
          });

          if (error) {
            throw error;
          }

          if (data.session) {
            localStorage.setItem('edo_sdg_admin_token', data.session.access_token);
            localStorage.setItem('edo_sdg_admin_email', data.session.user?.email || userInput);
            localStorage.setItem('edo_sdg_admin_name', data.session.user?.user_metadata?.full_name || 'Executive Officer');
            localStorage.setItem('edo_sdg_admin_role', data.session.user?.user_metadata?.role || 'Executive Member');
            window.location.href = '/admin';
            return;
          }
        }
        
        throw new Error('Invalid credentials. Username, email, or password not recognized.');
      } catch (err: any) {
        if (errorBox) {
          errorBox.classList.remove('hidden');
          errorBox.textContent = err.message || 'Invalid credentials. Only authorized executive accounts can sign in.';
        }
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.innerHTML = '<span class="material-symbols-outlined text-[20px]">login</span> Authenticate & Access Portal';
        }
      }
    });
  }
</script>
