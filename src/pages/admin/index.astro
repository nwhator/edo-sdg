---
import Layout from '../../layouts/Layout.astro';
import AdminHeader from '../../components/admin/AdminHeader.astro';
import { fetchIdeas, fetchProjects, fetchEvents, fetchFundingPartners } from '../../lib/supabase';

const ideas = await fetchIdeas();
const projects = await fetchProjects();
const { events, photos } = await fetchEvents();
const partners = await fetchFundingPartners();

const totalBudget = projects.reduce((acc, p) => acc + (Number(p.estimated_cost) || 0), 0);
---

<Layout
  title="Executive Command Center (Admin)"
  description="Executive portal for CDS project planning, budget management, proposal uploads, and event photo albums."
>
  <div class="max-w-7xl mx-auto px-margin-mobile md:px-margin-desktop py-space-xl space-y-space-xl">
    
    <AdminHeader />

    <!-- Metrics Ribbon Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-space-md">
      <!-- Card 1: Ideas -->
      <div class="bg-surface-container-lowest rounded-2xl border border-surface-container-high p-space-lg shadow-sm flex items-center justify-between">
        <div>
          <span class="font-label-sm text-label-sm uppercase tracking-wider text-outline font-bold">
            Community Ideas
          </span>
          <div class="font-stat-counter text-stat-counter text-on-surface mt-1">
            {ideas.length}
          </div>
          <span class="font-label-sm text-label-sm text-primary font-bold">
            {ideas.filter(i => i.status === 'submitted').length} pending review
          </span>
        </div>
        <div class="w-12 h-12 rounded-2xl bg-secondary-container/30 text-secondary flex items-center justify-center text-xl font-bold">
          <span class="material-symbols-outlined text-[28px]">lightbulb</span>
        </div>
      </div>

      <!-- Card 2: Planned Projects -->
      <div class="bg-surface-container-lowest rounded-2xl border border-surface-container-high p-space-lg shadow-sm flex items-center justify-between">
        <div>
          <span class="font-label-sm text-label-sm uppercase tracking-wider text-outline font-bold">
            Planned Projects
          </span>
          <div class="font-stat-counter text-stat-counter text-on-surface mt-1">
            {projects.length}
          </div>
          <span class="font-label-sm text-label-sm text-secondary font-bold">
            ₦{totalBudget.toLocaleString()} Planned Budget
          </span>
        </div>
        <div class="w-12 h-12 rounded-2xl bg-surface-container text-primary flex items-center justify-center text-xl font-bold">
          <span class="material-symbols-outlined text-[28px]">payments</span>
        </div>
      </div>

      <!-- Card 3: Events & Gallery -->
      <div class="bg-surface-container-lowest rounded-2xl border border-surface-container-high p-space-lg shadow-sm flex items-center justify-between">
        <div>
          <span class="font-label-sm text-label-sm uppercase tracking-wider text-outline font-bold">
            Outreach Albums
          </span>
          <div class="font-stat-counter text-stat-counter text-on-surface mt-1">
            {events.length}
          </div>
          <span class="font-label-sm text-label-sm text-tertiary font-bold">
            {photos.length} photos grouped
          </span>
        </div>
        <div class="w-12 h-12 rounded-2xl bg-surface-container text-tertiary flex items-center justify-center text-xl font-bold">
          <span class="material-symbols-outlined text-[28px]">photo_library</span>
        </div>
      </div>

      <!-- Card 4: NGO Directory -->
      <div class="bg-surface-container-lowest rounded-2xl border border-surface-container-high p-space-lg shadow-sm flex items-center justify-between">
        <div>
          <span class="font-label-sm text-label-sm uppercase tracking-wider text-outline font-bold">
            Benin NGO Partners
          </span>
          <div class="font-stat-counter text-stat-counter text-on-surface mt-1">
            {partners.length}
          </div>
          <span class="font-label-sm text-label-sm text-primary font-bold">
            Vetted for outreach
          </span>
        </div>
        <div class="w-12 h-12 rounded-2xl bg-primary-container/10 text-primary flex items-center justify-center text-xl font-bold">
          <span class="material-symbols-outlined text-[28px]">corporate_fare</span>
        </div>
      </div>
    </div>

    <!-- CDS Priority Outreach Working Group (INTERNAL ONLY) -->
    <div class="bg-surface-container-lowest rounded-2xl border border-surface-container-high p-space-xl space-y-space-md shadow-sm">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-space-sm border-b border-surface-container-high">
        <div>
          <span class="font-label-sm text-label-sm uppercase tracking-wider text-primary font-bold">
            Executive Outreach Priority
          </span>
          <h2 class="font-headline-md text-headline-md text-on-surface font-bold mt-0.5">
            Baseline Outreach Campaigns (Pads & Environmental Sanitation)
          </h2>
          <p class="font-body-sm text-body-sm text-on-surface-variant">
            Executive research and templates for securing local NGO sponsorships and material donations.
          </p>
        </div>
        <div class="flex items-center gap-2">
          <a
            href="/admin/funding"
            class="px-3.5 py-1.5 rounded-xl bg-primary text-on-primary font-label-sm text-label-sm font-bold hover:bg-primary-container transition-colors shadow-xs"
          >
            Benin NGO Directory →
          </a>
          <a
            href="/admin/pitch-kit"
            class="px-3.5 py-1.5 rounded-xl bg-secondary-container text-on-secondary-container font-label-sm text-label-sm font-bold hover:bg-secondary-fixed transition-colors shadow-xs"
          >
            Pitch Letter Drafts →
          </a>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-space-lg">
        <!-- Priority 1: Women's Health & Sanitary Pads -->
        <div class="rounded-xl border border-error-container bg-error-container/20 p-space-lg space-y-space-sm flex flex-col justify-between">
          <div class="space-y-space-xs">
            <div class="flex items-center justify-between">
              <span class="material-symbols-outlined text-error text-[28px]">emergency_home</span>
              <span class="font-label-sm text-label-sm text-error bg-error-container px-space-sm py-0.5 rounded-full font-bold uppercase">
                Target: 500 Packs
              </span>
            </div>
            <div>
              <h3 class="font-title-md text-title-md font-bold text-on-surface">
                Menstrual Health & School Sanitary Pad Banks
              </h3>
              <p class="font-body-sm text-body-sm text-on-surface-variant mt-1 leading-relaxed">
                Period poverty causes girls in Benin City to miss classes. Executive goal: secure in-kind pad donations from partners like Girls' Power Initiative (GPI) and distribute to Emotan College, Idia College, and Western Boys High School.
              </p>
            </div>
            <div class="p-space-sm rounded-lg bg-surface-container-lowest border border-error-container text-xs space-y-1">
              <div class="flex justify-between font-bold text-on-surface">
                <span>Estimated Target Budget:</span>
                <span class="text-error font-extrabold">₦385,000 (or in-kind pads)</span>
              </div>
              <p class="text-outline text-[11px]">Contacts: GPI Benin, AWEG, GWEDO, Edo SDGs Office.</p>
            </div>
          </div>

          <div class="pt-space-xs flex items-center justify-between">
            <a
              href="/admin/funding"
              class="font-label-sm text-label-sm font-bold text-error hover:underline flex items-center gap-1"
            >
              <span>View Pad Donors</span>
              <span>→</span>
            </a>
            <a
              href="/admin/pitch-kit"
              class="px-3 py-1.5 rounded-lg bg-error text-on-error font-label-sm text-label-sm font-bold hover:opacity-90 transition-opacity"
            >
              Get Pad Pitch Letter
            </a>
          </div>
        </div>

        <!-- Priority 2: Environmental Sanitation & Cleaning Materials -->
        <div class="rounded-xl border border-tertiary-container bg-tertiary-container/10 p-space-lg space-y-space-sm flex flex-col justify-between">
          <div class="space-y-space-xs">
            <div class="flex items-center justify-between">
              <span class="material-symbols-outlined text-tertiary text-[28px]">recycling</span>
              <span class="font-label-sm text-label-sm text-tertiary bg-tertiary-fixed px-space-sm py-0.5 rounded-full font-bold uppercase">
                Logistics & Gear
              </span>
            </div>
            <div>
              <h3 class="font-title-md text-title-md font-bold text-on-surface">
                Market Sanitation & Drainage Clearance
              </h3>
              <p class="font-body-sm text-body-sm text-on-surface-variant mt-1 leading-relaxed">
                Clearing blocked storm drains and market waste around Ring Road and Oba Market. Executive goal: partner with Edo State Waste Management Board (ESWMB) and Rotary Club of Benin for brooms, rakes, waste bags, and truck evacuation.
              </p>
            </div>
            <div class="p-space-sm rounded-lg bg-surface-container-lowest border border-tertiary-container text-xs space-y-1">
              <div class="flex justify-between font-bold text-on-surface">
                <span>Target Materials:</span>
                <span class="text-tertiary font-extrabold">200 Heavy bags, 50 brooms, rakes</span>
              </div>
              <p class="text-outline text-[11px]">Contacts: ESWMB Governor's Office, Rotary Club of Benin, ANEEJ.</p>
            </div>
          </div>

          <div class="pt-space-xs flex items-center justify-between">
            <a
              href="/admin/funding"
              class="font-label-sm text-label-sm font-bold text-tertiary hover:underline flex items-center gap-1"
            >
              <span>View Sanitation Partners</span>
              <span>→</span>
            </a>
            <a
              href="/admin/pitch-kit"
              class="px-3 py-1.5 rounded-lg bg-tertiary text-on-tertiary font-label-sm text-label-sm font-bold hover:opacity-90 transition-opacity"
            >
              Get ESWMB Letter
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Management Workspaces: Projects & Gallery -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-space-lg">
      
      <!-- Section A: Project Planning Shortcuts -->
      <div class="bg-surface-container-lowest rounded-2xl border border-surface-container-high p-space-lg space-y-space-md shadow-sm">
        <div class="flex items-center justify-between pb-space-xs border-b border-surface-container-high">
          <h2 class="font-title-md text-title-md font-bold text-on-surface">Planned Initiatives</h2>
          <a href="/admin/projects/new" class="font-label-sm text-label-sm font-bold text-primary hover:underline">
            + Plan Project
          </a>
        </div>

        {projects.length === 0 ? (
          <div class="p-space-lg text-center bg-surface-container-low rounded-xl border border-dashed border-outline-variant space-y-1">
            <p class="font-label-md text-label-md font-bold text-on-surface">No projects planned yet</p>
            <p class="font-body-sm text-body-sm text-on-surface-variant">
              Approved ideas can be converted into planned initiatives with budget breakdowns.
            </p>
            <div class="pt-space-xs">
              <a
                href="/admin/projects/new"
                class="inline-block px-4 py-2 rounded-xl bg-primary text-on-primary font-label-sm text-label-sm font-bold hover:bg-primary-container"
              >
                + Plan First Project
              </a>
            </div>
          </div>
        ) : (
          <div class="space-y-space-xs">
            {projects.map((p) => (
              <div class="p-3.5 rounded-xl bg-surface-container-low border border-surface-container-high flex items-center justify-between gap-3">
                <div class="space-y-0.5">
                  <h4 class="font-label-md text-label-md font-bold text-on-surface line-clamp-1">{p.title}</h4>
                  <div class="flex items-center gap-2 font-label-sm text-xs text-on-surface-variant">
                    <span>₦{Number(p.estimated_cost).toLocaleString()}</span>
                    <span>•</span>
                    <span>{p.stakeholders_to_reach.length} stakeholders</span>
                  </div>
                </div>
                <a
                  href="/projects"
                  class="px-3 py-1 rounded-lg bg-surface-container-lowest border border-surface-container-high font-label-sm text-label-sm font-bold text-on-surface hover:bg-surface-container"
                >
                  View
                </a>
              </div>
            ))}
          </div>
        )}
      </div>

      <!-- Section B: Event Gallery Management -->
      <div class="bg-surface-container-lowest rounded-2xl border border-surface-container-high p-space-lg space-y-space-md shadow-sm">
        <div class="flex items-center justify-between pb-space-xs border-b border-surface-container-high">
          <h2 class="font-title-md text-title-md font-bold text-on-surface">Event Photo Albums</h2>
          <a href="/admin/gallery/new" class="font-label-sm text-label-sm font-bold text-primary hover:underline">
            + Upload Photos
          </a>
        </div>

        {events.length === 0 ? (
          <div class="p-space-lg text-center bg-surface-container-low rounded-xl border border-dashed border-outline-variant space-y-1">
            <p class="font-label-md text-label-md font-bold text-on-surface">No event albums uploaded yet</p>
            <p class="font-body-sm text-body-sm text-on-surface-variant">
              Upload photos grouped by outreach event to display in the public gallery.
            </p>
            <div class="pt-space-xs">
              <a
                href="/admin/gallery/new"
                class="inline-block px-4 py-2 rounded-xl bg-secondary-container text-on-secondary-container font-label-sm text-label-sm font-bold hover:bg-secondary-fixed"
              >
                + Upload Event Photos
              </a>
            </div>
          </div>
        ) : (
          <div class="space-y-space-xs">
            {events.map((e) => (
              <div class="p-3.5 rounded-xl bg-surface-container-low border border-surface-container-high flex items-center justify-between gap-3">
                <div class="space-y-0.5">
                  <h4 class="font-label-md text-label-md font-bold text-on-surface line-clamp-1">{e.title}</h4>
                  <div class="flex items-center gap-2 font-label-sm text-xs text-on-surface-variant">
                    <span>📅 {e.event_date}</span>
                    <span>•</span>
                    <span>📍 {e.location}</span>
                  </div>
                </div>
                <a
                  href={`/gallery#event-${e.id}`}
                  class="px-3 py-1 rounded-lg bg-surface-container-lowest border border-surface-container-high font-label-sm text-label-sm font-bold text-on-surface hover:bg-surface-container"
                >
                  Gallery
                </a>
              </div>
            ))}
          </div>
        )}
      </div>

    </div>

  </div>
</Layout>
