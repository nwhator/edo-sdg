---
import Layout from '../layouts/Layout.astro';
import { fetchIdeas, fetchFundingPartners, fetchEvents } from '../lib/supabase';
import { SDG_METADATA } from '../types/database';
import { IdeasStatCounter } from '../components/ideas/IdeasStatCounter';
import { HomeIdeasSection } from '../components/ideas/HomeIdeasSection';
import SdgSpectrumBar from '../components/SdgSpectrumBar.astro';

const ideas = await fetchIdeas();
const partners = await fetchFundingPartners();
const { events, photos } = await fetchEvents();
const uweluEvent = events.find((e) => e.id === 'evt-uwelu-market-sanitation-sdg6') || events[0];
const uweluPhotos = photos.filter((p) => p.event_id === uweluEvent?.id || p.image_url.includes('uwelu_market'));
const topIdeas = [...ideas].sort((a, b) => ((b.upvotes_count || 0) - (a.upvotes_count || 0)) || (new Date(b.created_at).getTime() - new Date(a.created_at).getTime())).slice(0, 6);
const sdgList = Object.values(SDG_METADATA);
---

<Layout
  title="Home • NYSC Egor SDG CDS Group"
  description="Official platform of the NYSC Sustainable Development Goals (SDG) CDS Group, Egor Local Government Area. Weekly Meeting every Wednesday at Egor NYSC Secretariat."
>
  <div class="flex flex-col w-full">
    
    <!-- Editorial Civic Hero -->
    <section class="relative bg-ledger-grid border-b border-on-surface/10 pt-8 md:pt-14 pb-12 md:pb-16 overflow-hidden">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
          
          <!-- Left Column: Civic Statement & Actions -->
          <div class="lg:col-span-7 space-y-6">
            
            <!-- Dispatch Status Pill -->
            <div class="inline-flex flex-wrap items-center gap-2.5 bg-surface-container-lowest px-3.5 py-1.5 rounded-lg border border-on-surface/15 shadow-subtle">
              <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
              <span class="font-mono text-[11px] font-bold uppercase tracking-wider text-primary">
                Egor LGA • Chapter ED/CDS/SDG/24-B
              </span>
              <span class="text-outline-variant">|</span>
              <span class="font-mono text-[11px] text-on-surface-variant">
                Wednesdays @ 09:00 WAT
              </span>
            </div>

            <!-- Main Headline with Editorial Serif Contrast -->
            <h1 class="text-4xl sm:text-5xl lg:text-[56px] font-extrabold text-on-surface tracking-tight leading-[1.08]">
              Localizing the <span class="font-serif italic font-normal text-primary">2030 Agenda</span> across Egor LGA
            </h1>

            <!-- Subtitle -->
            <p class="text-base sm:text-lg text-on-surface-variant max-w-2xl leading-relaxed">
              The public civic ledger and ideation hub for the NYSC Sustainable Development Goals (SDG) CDS Group in Benin City. Serving corps members pitching community solutions, publishing itemized budgets, and executing grassroots impact.
            </p>

            <!-- Primary & Secondary Actions -->
            <div class="pt-1 flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
              <a
                href="/ideas#drop"
                class="inline-flex items-center justify-center gap-2 h-12 px-6 rounded-xl bg-primary hover:bg-primary-container text-on-primary font-bold text-sm shadow-ledger hover:translate-y-[-1px] active:translate-y-0 transition-all"
              >
                <span class="material-symbols-outlined text-[19px]">lightbulb</span>
                <span>Pitch a Community Idea</span>
              </a>

              <a
                href="/projects"
                class="inline-flex items-center justify-center gap-2 h-12 px-5 rounded-xl bg-surface-container-lowest hover:bg-surface-container-low text-on-surface font-bold text-sm border border-on-surface/15 transition-all"
              >
                <span class="material-symbols-outlined text-[18px] text-primary">account_balance_wallet</span>
                <span>Open Budget Ledger</span>
              </a>

              <a
                href="/partner"
                class="inline-flex items-center justify-center gap-2 h-12 px-5 rounded-xl bg-secondary-container/30 hover:bg-secondary-container/50 text-on-secondary-fixed font-bold text-sm border border-secondary/30 transition-all"
              >
                <span class="material-symbols-outlined text-[18px] text-secondary">handshake</span>
                <span>Partner / CSR</span>
              </a>
            </div>

            <!-- Architectural Ledger Metrics Strip -->
            <div class="pt-4">
              <div class="grid grid-cols-2 sm:grid-cols-4 bg-surface-container-lowest rounded-xl border border-on-surface/12 divide-y sm:divide-y-0 sm:divide-x divide-on-surface/10 shadow-subtle overflow-hidden">
                <div class="p-3.5 sm:p-4">
                  <div class="font-mono text-[10px] uppercase tracking-wider text-on-surface-variant">Framework</div>
                  <div class="text-2xl font-extrabold text-primary font-display tabular-nums mt-0.5">17</div>
                  <div class="text-[11px] font-semibold text-on-surface">UN Global Goals</div>
                </div>
                <div class="p-3.5 sm:p-4">
                  <div class="font-mono text-[10px] uppercase tracking-wider text-on-surface-variant">Civic Voice</div>
                  <div class="mt-0.5">
                    <IdeasStatCounter client:load initialCount={ideas.length || 5} />
                  </div>
                  <div class="text-[11px] font-semibold text-on-surface">Ideas Dropped</div>
                </div>
                <div class="p-3.5 sm:p-4">
                  <div class="font-mono text-[10px] uppercase tracking-wider text-on-surface-variant">Volunteer Corps</div>
                  <div class="text-2xl font-extrabold text-tertiary font-display tabular-nums mt-0.5">120+</div>
                  <div class="text-[11px] font-semibold text-on-surface">Active Members</div>
                </div>
                <div class="p-3.5 sm:p-4">
                  <div class="font-mono text-[10px] uppercase tracking-wider text-on-surface-variant">Alliances</div>
                  <div class="text-2xl font-extrabold text-secondary font-display tabular-nums mt-0.5">{partners.length || 8}</div>
                  <div class="text-[11px] font-semibold text-on-surface">Mapped Partners</div>
                </div>
              </div>
            </div>

          </div>

          <!-- Right Column: Field Dossier Card -->
          <div class="lg:col-span-5">
            <div class="bg-surface-container-lowest rounded-2xl border border-on-surface/15 shadow-elevated overflow-hidden">
              
              <!-- Dossier Top Bar -->
              <div class="px-4 py-3 bg-surface-container-low border-b border-on-surface/10 flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <span class="w-2.5 h-2.5 rounded-full bg-primary"></span>
                  <span class="font-mono text-[11px] font-bold uppercase tracking-wider text-on-surface">
                    Field Dossier • Egor Secretariat
                  </span>
                </div>
                <span class="font-mono text-[10px] px-2 py-0.5 rounded bg-primary/10 text-primary font-bold">
                  VERIFIED CDS
                </span>
              </div>

              <!-- Real Local Documentary Photo -->
              <div class="relative h-60 sm:h-64 overflow-hidden bg-inverse-surface group">
                <img
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  alt="NYSC Egor SDG CDS corps members during Ogida Market SDG 4 field sensitization"
                  src="/ogida/1.jpg"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-inverse-surface/90 via-inverse-surface/20 to-transparent flex flex-col justify-end p-4">
                  <span class="font-mono text-[10px] text-secondary-container uppercase tracking-widest font-bold">
                    Field Archive • Ogida Market Outreach
                  </span>
                  <p class="text-sm text-white font-bold leading-snug mt-0.5">
                    Corps Members Mobilizing Grassroots SDG Action in Benin City
                  </p>
                </div>
              </div>

              <!-- Secretariat Schedule Ledger -->
              <div class="p-4 bg-inverse-surface text-inverse-on-surface space-y-2.5">
                <div class="flex items-center justify-between text-xs border-b border-white/10 pb-2">
                  <span class="font-mono text-[11px] text-white/65 uppercase">Assembly Venue</span>
                  <span class="font-bold text-white">Egor NYSC Secretariat</span>
                </div>
                <div class="flex items-center justify-between text-xs border-b border-white/10 pb-2">
                  <span class="font-mono text-[11px] text-white/65 uppercase">Weekly Schedule</span>
                  <span class="font-bold text-secondary-container tabular-nums">Every Wednesday • 9:00 AM</span>
                </div>
                <div class="flex items-center justify-between text-xs pt-0.5">
                  <span class="font-mono text-[11px] text-white/65 uppercase">Jurisdiction</span>
                  <span class="font-semibold text-primary-fixed">Egor LGA, Edo State</span>
                </div>
              </div>

            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- Main Content Flow -->
    <div class="flex flex-col w-full space-y-14 md:space-y-20 py-12 md:py-16">

      <!-- Featured Latest Field Dispatch & Video (Uwelu Market SDG 6 - Nov 25, 2026) -->
      <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
        <div class="bg-surface-container-lowest rounded-2xl border border-on-surface/15 shadow-card overflow-hidden">
          
          <!-- Dispatch Header Strip -->
          <div class="px-6 py-4 bg-inverse-surface text-white flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div class="flex items-center gap-3">
              <span class="px-2.5 py-1 rounded bg-[#26BDE2] text-white font-mono text-[11px] font-bold uppercase tracking-wider">
                Dispatch #08 • SDG 6
              </span>
              <span class="font-mono text-xs text-white/80">
                WED 25 NOV 2026 • UWELU MARKET SANITATION
              </span>
            </div>
            <div class="inline-flex items-center gap-2 font-mono text-[11px] text-primary-fixed">
              <span class="w-2 h-2 rounded-full bg-secondary-container animate-pulse"></span>
              <span>FIELD VIDEO & 32 PLATES</span>
            </div>
          </div>

          <div class="p-6 sm:p-8 lg:p-10 grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
            
            <!-- Left Column: Cinema Frame Vertical Video -->
            <div class="lg:col-span-5 flex flex-col items-center space-y-3">
              <div class="relative w-full max-w-[310px] aspect-[9/16] rounded-2xl overflow-hidden bg-black shadow-elevated border-2 border-on-surface/20">
                <video
                  controls
                  playsinline
                  preload="metadata"
                  poster="/uwelu_market/001.jpg"
                  class="w-full h-full object-cover bg-black"
                >
                  <source src="/uwelu_market/uwelu_video.mp4" type="video/mp4" />
                  Your browser does not support the video tag.
                </video>
                
                <div class="absolute top-3 left-3 flex flex-wrap gap-1.5 pointer-events-none">
                  <span class="px-2.5 py-0.5 bg-[#26BDE2] text-white text-[10px] font-extrabold rounded font-mono uppercase">
                    SDG 6
                  </span>
                  <span class="px-2.5 py-0.5 bg-[#FD9D24] text-white text-[10px] font-extrabold rounded font-mono uppercase">
                    SDG 11
                  </span>
                  <span class="px-2.5 py-0.5 bg-black/75 backdrop-blur text-white text-[10px] font-mono rounded">
                    WEEK 8
                  </span>
                </div>
              </div>
              <p class="text-xs text-on-surface-variant text-center max-w-[310px] leading-relaxed">
                <strong class="text-on-surface">Field Action Reel:</strong> Edo State NYSC SDG volunteers carrying out environmental sanitation & sensitization at Uwelu Market.
              </p>
            </div>

            <!-- Right Column: Editorial Narrative & Outcomes -->
            <div class="lg:col-span-7 space-y-5">
              <div class="space-y-2">
                <h2 class="text-2xl sm:text-3xl font-extrabold text-on-surface tracking-tight leading-tight">
                  Promoting Clean Water & Sanitation Through Community Action at Uwelu Market
                </h2>
                <p class="text-sm text-on-surface-variant leading-relaxed">
                  On Wednesday, 25 November 2026, Edo State NYSC SDG CDS volunteers mobilized at Uwasota Road, Uwelu Market, Edo State—cleaning market sections, sanitizing roadsides, evacuating over 10 bags of waste, and sensitizing traders on SDG 6 and public health.
                </p>
              </div>

              <!-- 4-Cell Key Facts Strip -->
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 text-xs">
                <div class="p-3 rounded-xl bg-surface-container-low border border-on-surface/10">
                  <span class="font-mono text-[10px] text-on-surface-variant uppercase block">Exercise Date</span>
                  <span class="font-bold text-on-surface mt-0.5 block">25 Nov 2026</span>
                </div>
                <div class="p-3 rounded-xl bg-surface-container-low border border-on-surface/10">
                  <span class="font-mono text-[10px] text-on-surface-variant uppercase block">Location</span>
                  <span class="font-bold text-primary mt-0.5 block">Uwelu Market</span>
                </div>
                <div class="p-3 rounded-xl bg-surface-container-low border border-on-surface/10">
                  <span class="font-mono text-[10px] text-on-surface-variant uppercase block">Waste Cleared</span>
                  <span class="font-bold text-on-surface mt-0.5 block">10+ Bags</span>
                </div>
                <div class="p-3 rounded-xl bg-surface-container-low border border-on-surface/10">
                  <span class="font-mono text-[10px] text-on-surface-variant uppercase block">Primary Focus</span>
                  <span class="font-bold text-[#0A97D9] mt-0.5 block">SDG 6 (WASH)</span>
                </div>
              </div>

              <!-- 5 Key Activities -->
              <div class="p-4 rounded-xl bg-surface border border-on-surface/10 space-y-2.5">
                <span class="font-mono text-[10px] font-bold text-primary uppercase tracking-widest block">
                  Field Activities & Community Engagement (09:00 AM Kickoff)
                </span>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-1.5 text-xs font-semibold text-on-surface">
                  <div class="flex items-center gap-2"><span class="font-mono text-[10px] text-primary">01</span><span>Environmental Market Cleaning</span></div>
                  <div class="flex items-center gap-2"><span class="font-mono text-[10px] text-primary">02</span><span>Roadside Sanitation (Uwasota Rd)</span></div>
                  <div class="flex items-center gap-2"><span class="font-mono text-[10px] text-primary">03</span><span>10+ Bags Waste Evacuated</span></div>
                  <div class="flex items-center gap-2"><span class="font-mono text-[10px] text-primary">04</span><span>Trader Hygiene Sensitization</span></div>
                  <div class="flex items-center gap-2 sm:col-span-2"><span class="font-mono text-[10px] text-primary">05</span><span>Public Health & Waterborne Disease Prevention</span></div>
                </div>
              </div>

              <!-- Contact Sheet Photo Preview Strip (001, 002, 003 + next 2) -->
              <div class="space-y-2">
                <div class="flex items-center justify-between text-xs">
                  <span class="font-mono text-[11px] font-bold text-on-surface uppercase tracking-wider">
                    Contact Sheet ({uweluPhotos.length || 32} Plates • 001–003 Lead)
                  </span>
                  <a href="/events" class="text-primary font-bold hover:underline text-xs">
                    Open Full Archive →
                  </a>
                </div>
                <div class="grid grid-cols-5 gap-2">
                  {uweluPhotos.slice(0, 5).map((photo, idx) => (
                    <a
                      key={photo.id}
                      href="/blog/uwelu-market-environmental-sanitation-sdg-6#photo-gallery"
                      class="relative aspect-4/3 rounded-lg overflow-hidden border border-on-surface/15 hover:border-primary transition-all group/item"
                      title={`Plate #${String(idx + 1).padStart(3, '0')}`}
                    >
                      <img
                        src={photo.image_url}
                        alt={`Uwelu Market Sanitation Plate ${idx + 1}`}
                        class="w-full h-full object-cover group-hover/item:scale-105 transition-transform"
                        loading="lazy"
                      />
                      <div class="absolute bottom-1 right-1 px-1 py-0.5 bg-black/70 text-[9px] font-mono font-bold text-white rounded">
                        #{String(idx + 1).padStart(3, '0')}
                      </div>
                    </a>
                  ))}
                </div>
              </div>

              <!-- Action Buttons -->
              <div class="pt-1 flex flex-wrap items-center gap-3">
                <a
                  href="/blog/uwelu-market-environmental-sanitation-sdg-6"
                  class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-primary hover:bg-primary-container text-on-primary text-xs sm:text-sm font-bold shadow-subtle transition-all active:scale-95"
                >
                  <span>Read Full Uwelu Market Report</span>
                  <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
                </a>
                <a
                  href="/events"
                  class="inline-flex items-center gap-1.5 px-4 py-3 rounded-xl bg-surface-container-low hover:bg-surface-container text-on-surface border border-on-surface/15 text-xs sm:text-sm font-bold transition-all"
                >
                  <span class="material-symbols-outlined text-[18px] text-primary">photo_library</span>
                  <span>Gallery ({uweluPhotos.length || 32})</span>
                </a>
                <a
                  href="/blog/minutes-sdg-cds-meeting-nov-11-2026"
                  class="inline-flex items-center gap-1.5 px-3 py-2 text-on-surface-variant hover:text-primary text-xs font-semibold transition-colors"
                >
                  <span class="material-symbols-outlined text-[16px]">history_edu</span>
                  <span>Nov 11 Meeting Minutes</span>
                </a>
              </div>

            </div>
          </div>
        </div>
      </section>

      <!-- Trending Community Ideas for Egor LGA -->
      <HomeIdeasSection client:load initialIdeas={topIdeas} initialTotalCount={ideas.length || topIdeas.length} />

      <!-- UN 17 SDGs Architectural Matrix -->
      <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full" id="sdg-grid">
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8 pb-4 border-b border-on-surface/12">
          <div class="space-y-1.5">
            <span class="font-mono text-[11px] font-bold text-primary uppercase tracking-widest">
              UN 2030 Agenda • Local Egor Mandate
            </span>
            <h2 class="text-2xl sm:text-4xl font-extrabold text-on-surface tracking-tight">
              The 17 Sustainable <span class="font-serif italic font-normal text-primary">Development Goals</span>
            </h2>
          </div>
          <p class="text-xs sm:text-sm text-on-surface-variant max-w-md">
            Every project planned at the Egor NYSC Secretariat is mapped directly to one or more of these 17 global targets.
          </p>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3">
          {sdgList.map((sdg) => (
            <div
              style={{ backgroundColor: sdg.color }}
              class="group relative rounded-xl p-4 text-white transition-all hover:-translate-y-1 shadow-subtle hover:shadow-card min-h-[132px] flex flex-col justify-between overflow-hidden"
            >
              <div class="flex justify-between items-start">
                <span class="font-mono text-xl font-extrabold opacity-90 tracking-tighter">
                  {String(sdg.number).padStart(2, '0')}
                </span>
                <span class="font-mono text-[9px] uppercase tracking-widest px-1.5 py-0.5 rounded bg-black/20">
                  SDG
                </span>
              </div>
              <div class="pt-3">
                <h3 class="text-xs sm:text-sm font-extrabold leading-tight">
                  {sdg.name}
                </h3>
                <p class="text-[10px] opacity-85 mt-1 line-clamp-1">
                  {sdg.shortDescription}
                </p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- High-Contrast Partnership & CSR Callout -->
      <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
        <div class="bg-inverse-surface text-inverse-on-surface rounded-2xl overflow-hidden border border-white/10 shadow-elevated">
          <SdgSpectrumBar heightClass="h-1" />
          <div class="p-6 sm:p-10 lg:p-12 flex flex-col lg:flex-row items-start lg:items-center justify-between gap-8">
            <div class="space-y-3 max-w-2xl">
              <span class="inline-block px-3 py-1 bg-secondary-container text-on-secondary-container font-mono text-[11px] font-bold uppercase tracking-wider rounded">
                0% Overhead • 100% Grassroots Delivery
              </span>
              <h3 class="text-2xl sm:text-4xl font-extrabold leading-tight text-white">
                Co-Sponsor Verified <span class="font-serif italic font-normal text-secondary-container">Impact</span> in Egor LGA
              </h3>
              <p class="text-xs sm:text-sm text-white/75 leading-relaxed">
                Serving corps members provide 100% of volunteer labor. Corporate CSR partners, NGOs, and philanthropists fund physical materials with full photographic closeout and LGI oversight.
              </p>
            </div>

            <div class="flex flex-col sm:flex-row gap-3 shrink-0 w-full lg:w-auto">
              <a
                href="/partner"
                class="text-center px-6 py-3.5 bg-secondary-container hover:bg-secondary-fixed text-on-secondary-container font-extrabold text-xs sm:text-sm rounded-xl shadow-sm transition-all active:scale-95 flex items-center justify-center gap-2"
              >
                <span class="material-symbols-outlined text-[18px]">handshake</span>
                <span>Partner / CSR Gateway</span>
              </a>
              <a
                href="/ideas#drop"
                class="text-center px-5 py-3.5 bg-white/10 hover:bg-white/20 text-white font-bold text-xs sm:text-sm rounded-xl transition-all border border-white/20"
              >
                Submit an Idea
              </a>
            </div>
          </div>
        </div>
      </section>

    </div>

  </div>
</Layout>
