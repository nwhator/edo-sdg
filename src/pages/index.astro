---
import Layout from '../layouts/Layout.astro';
import { fetchIdeas, fetchFundingPartners } from '../lib/supabase';
import { SDG_METADATA } from '../types/database';
import { IdeaCard } from '../components/ideas/IdeaCard';

const ideas = await fetchIdeas();
const partners = await fetchFundingPartners();
const topIdeas = [...ideas].sort((a, b) => (b.upvotes_count || 0) - (a.upvotes_count || 0)).slice(0, 3);
const sdgList = Object.values(SDG_METADATA);
---

<Layout
  title="Home • NYSC Egor SDG CDS Group"
  description="Official platform of the NYSC Sustainable Development Goals (SDG) CDS Group, Egor Local Government Area. Weekly Meeting every Wednesday at Egor NYSC Secretariat."
>
  <div class="flex flex-col w-full space-y-12 md:space-y-16">
    
    <!-- Hero Section (Clean, Less is More, FoodThrift-inspired) -->
    <section class="relative pt-6 md:pt-10 pb-8 bg-surface">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
          
          <!-- Left Column: Clear Message & Actions -->
          <div class="lg:col-span-7 space-y-5">
            
            <!-- Live Meeting Schedule Pill -->
            <div class="inline-flex items-center gap-2 bg-surface-container px-3.5 py-1.5 rounded-full border border-outline-variant/30 text-primary text-xs font-bold shadow-subtle">
              <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
              <span>Egor LGA • Meeting Every Wednesday @ Egor NYSC Secretariat</span>
            </div>

            <!-- Main Title -->
            <h1 class="text-3xl sm:text-5xl font-extrabold text-on-surface tracking-tight leading-[1.18]">
              Advancing the Global Goals in <span class="text-primary">Egor LGA</span>
            </h1>

            <!-- Subtitle -->
            <p class="text-base sm:text-lg text-on-surface-variant max-w-2xl leading-relaxed">
              Official platform of the NYSC Sustainable Development Goals (SDGs) CDS Group, Egor Local Government Area. Corps members sharing community ideas, tracking local interventions, and driving youth-led impact across Egor.
            </p>

            <!-- Clean, Easily Understandable CTAs -->
            <div class="pt-2 flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
              <a
                href="/ideas#drop"
                class="inline-flex items-center justify-center gap-2 h-12 px-7 rounded-xl bg-primary hover:bg-primary-container text-on-primary font-bold text-sm shadow-card hover:shadow-elevated active:scale-95 transition-all"
              >
                <span class="material-symbols-outlined text-[20px]">lightbulb</span>
                <span>Submit an Idea</span>
              </a>

              <a
                href="/projects"
                class="inline-flex items-center justify-center gap-2 h-12 px-5 rounded-xl bg-surface-container-lowest hover:bg-surface-container text-primary font-bold text-sm border border-outline-variant/40 shadow-subtle active:scale-95 transition-all"
              >
                <span class="material-symbols-outlined text-[18px]">folder_open</span>
                <span>Projects</span>
              </a>

              <a
                href="/partner"
                class="inline-flex items-center justify-center gap-2 h-12 px-5 rounded-xl bg-surface-container-lowest hover:bg-surface-container text-on-surface font-bold text-sm border border-secondary/30 shadow-subtle active:scale-95 transition-all"
              >
                <span class="material-symbols-outlined text-[18px] text-secondary">handshake</span>
                <span>Partner / CSR</span>
              </a>
            </div>

            <!-- Simple Trust Metrics -->
            <div class="flex flex-wrap items-center gap-6 pt-3 text-on-surface-variant text-xs">
              <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-primary text-[18px]">verified</span>
                <span class="font-semibold">NYSC Egor LGA Secretariat</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-secondary text-[18px]">schedule</span>
                <span class="font-semibold">Wednesdays @ 9:00 AM</span>
              </div>
            </div>

          </div>

          <!-- Right Column: Institutional Focus Card (Egor NYSC Secretariat) -->
          <div class="lg:col-span-5">
            <div class="bg-surface-container-lowest p-4 sm:p-6 rounded-2xl shadow-card border border-outline-variant/30 space-y-4">
              
              <!-- Insignia Header -->
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-xl bg-surface-container flex items-center justify-center text-primary font-extrabold text-sm shadow-subtle">
                    SDG
                  </div>
                  <div>
                    <h3 class="font-headline-sm text-sm font-bold text-on-surface">NYSC Egor SDG CDS</h3>
                    <p class="font-body-sm text-xs text-on-surface-variant">Edo State Secretariat Hub</p>
                  </div>
                </div>
                <span class="px-2.5 py-1 bg-surface-container text-primary text-[11px] font-bold rounded-full">
                  Egor Chapter
                </span>
              </div>

              <!-- Documentary Photo -->
              <div class="relative h-52 rounded-xl overflow-hidden shadow-subtle">
                <img
                  class="w-full h-full object-cover"
                  alt="NYSC corps members in khaki uniforms during weekly assembly in Egor"
                  src="https://lh3.googleusercontent.com/aida-public/AB6AXuC6CsW469yAlDdvPvSi6dFxhgMZ28IdBwXSuWXh3-07dIbw2ZSPQXCGRWNu47hRalg6AlnH5iPSkpwZgbZ8_KPW1PwzB0rlvQ6qI6hc1nhDCEm12mYDCURr14LAJp5juFfJEnrho_xJ6NLChH295F0kCK_CTEbQKf6SmrAs8od5gLr7Sr7dZ62qJSMg_2aoKaH9hOy8UsqjX4p9BISivNoTCuZBrm4SMesjsMd3nHPdtfYFubdGEV2uaw"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-on-surface/80 via-transparent to-transparent flex items-end p-3">
                  <p class="text-xs text-white font-medium">
                    Egor NYSC Secretariat CDS Weekly Assembly
                  </p>
                </div>
              </div>

              <!-- Quick Info Rows -->
              <div class="space-y-2 pt-1 font-body-sm text-xs text-on-surface">
                <div class="flex items-center justify-between p-2.5 rounded-lg bg-surface-container-low gap-2">
                  <span class="text-on-surface-variant font-medium flex items-center gap-1.5 shrink-0">
                    <span class="material-symbols-outlined text-[16px] text-primary">location_on</span>
                    Meeting Location
                  </span>
                  <span class="font-bold text-primary text-right">Egor NYSC Secretariat</span>
                </div>
                <div class="flex items-center justify-between p-2.5 rounded-lg bg-surface-container-low gap-2">
                  <span class="text-on-surface-variant font-medium flex items-center gap-1.5 shrink-0">
                    <span class="material-symbols-outlined text-[16px] text-primary">event</span>
                    Meeting Day
                  </span>
                  <span class="font-bold text-on-surface text-right">Every Wednesday @ 9:00 AM</span>
                </div>
              </div>

            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- Clean Impact Stats Bar -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4">
        
        <!-- Stat 1: UN Global Goals -->
        <div class="bg-surface-container-lowest p-3.5 sm:p-5 rounded-2xl shadow-subtle border border-outline-variant/30 hover:border-primary/40 transition-colors">
          <div class="flex items-center justify-between mb-1.5 sm:mb-2">
            <span class="text-[10px] sm:text-[11px] font-bold uppercase tracking-wider text-on-surface-variant">UN Framework</span>
            <span class="material-symbols-outlined text-primary text-[18px] sm:text-[20px]">public</span>
          </div>
          <div class="text-2xl sm:text-3xl font-extrabold text-primary font-display">17</div>
          <p class="text-xs sm:text-sm font-bold text-on-surface mt-0.5">Global Goals</p>
          <p class="text-[11px] sm:text-xs text-on-surface-variant mt-0.5">Guiding all Egor projects</p>
        </div>

        <!-- Stat 2: Ideas Dropped -->
        <div class="bg-surface-container-lowest p-3.5 sm:p-5 rounded-2xl shadow-subtle border border-outline-variant/30 hover:border-secondary/40 transition-colors">
          <div class="flex items-center justify-between mb-1.5 sm:mb-2">
            <span class="text-[10px] sm:text-[11px] font-bold uppercase tracking-wider text-on-surface-variant">Community Voice</span>
            <span class="material-symbols-outlined text-secondary text-[18px] sm:text-[20px]">lightbulb</span>
          </div>
          <div class="text-2xl sm:text-3xl font-extrabold text-secondary font-display">{ideas.length}</div>
          <p class="text-xs sm:text-sm font-bold text-on-surface mt-0.5">Ideas Dropped</p>
          <p class="text-[11px] sm:text-xs text-on-surface-variant mt-0.5">Submitted anonymously</p>
        </div>

        <!-- Stat 3: Active Volunteers -->
        <div class="bg-surface-container-lowest p-3.5 sm:p-5 rounded-2xl shadow-subtle border border-outline-variant/30 hover:border-tertiary/40 transition-colors">
          <div class="flex items-center justify-between mb-1.5 sm:mb-2">
            <span class="text-[10px] sm:text-[11px] font-bold uppercase tracking-wider text-on-surface-variant">Volunteer Corps</span>
            <span class="material-symbols-outlined text-tertiary text-[18px] sm:text-[20px]">groups</span>
          </div>
          <div class="text-2xl sm:text-3xl font-extrabold text-tertiary font-display">120+</div>
          <p class="text-xs sm:text-sm font-bold text-on-surface mt-0.5">Corps Members</p>
          <p class="text-[11px] sm:text-xs text-on-surface-variant mt-0.5">Serving across Egor LGA</p>
        </div>

        <!-- Stat 4: Civil Alliances -->
        <div class="bg-surface-container-lowest p-3.5 sm:p-5 rounded-2xl shadow-subtle border border-outline-variant/30 hover:border-primary/40 transition-colors">
          <div class="flex items-center justify-between mb-1.5 sm:mb-2">
            <span class="text-[10px] sm:text-[11px] font-bold uppercase tracking-wider text-on-surface-variant">Civil Network</span>
            <span class="material-symbols-outlined text-primary text-[18px] sm:text-[20px]">handshake</span>
          </div>
          <div class="text-2xl sm:text-3xl font-extrabold text-primary font-display">{partners.length || 8}</div>
          <p class="text-xs sm:text-sm font-bold text-on-surface mt-0.5">Partner Contacts</p>
          <p class="text-[11px] sm:text-xs text-on-surface-variant mt-0.5">Mapped for outreach</p>
        </div>

      </div>
    </section>

    <!-- Latest Verified Community Outreach Feature (Ogida Market Sensitization) -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
      <div class="bg-gradient-to-br from-surface-container-lowest to-surface-container-low p-6 sm:p-8 rounded-3xl border border-primary/20 shadow-card space-y-6">
        <div class="flex flex-col lg:flex-row items-center gap-6 lg:gap-8">
          
          <!-- Image with Badge -->
          <div class="relative w-full lg:w-5/12 h-64 sm:h-72 rounded-2xl overflow-hidden shadow-subtle shrink-0 group">
            <img
              src="/ogida/photo_2026-10-21_17-41-10.jpg"
              alt="Quality Education SDG 4 Sensitization at Ogida Market"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
            <div class="absolute top-3 left-3 flex flex-wrap gap-2">
              <span class="px-2.5 py-1 bg-primary text-on-primary text-[11px] font-extrabold rounded-full shadow-sm">
                SDG 4 • Quality Education
              </span>
              <span class="px-2.5 py-1 bg-surface-container-lowest/90 backdrop-blur text-on-surface text-[11px] font-bold rounded-full">
                Week 3 • 4th Quarter
              </span>
            </div>
            <div class="absolute bottom-3 left-3 right-3 text-white text-xs font-medium flex items-center justify-between">
              <span class="flex items-center gap-1.5">
                <span class="material-symbols-outlined text-[16px] text-tertiary">location_on</span>
                Ogida Market, Benin City
              </span>
              <span class="bg-black/40 px-2 py-0.5 rounded text-[11px]">28 Photos</span>
            </div>
          </div>

          <!-- Narrative Details -->
          <div class="w-full lg:w-7/12 space-y-3.5">
            <div class="inline-flex items-center gap-1.5 text-primary text-xs font-bold uppercase tracking-wider">
              <span class="material-symbols-outlined text-[16px]">verified</span>
              <span>Latest Official Outreach • Oct 21, 2026</span>
            </div>
            
            <h2 class="text-xl sm:text-2xl font-extrabold text-on-surface leading-snug">
              Sensitization on the Importance of Quality Education (SDG 4) & Parental Involvement at Ogida Market
            </h2>

            <p class="text-xs sm:text-sm text-on-surface-variant leading-relaxed line-clamp-3">
              Sensitizing market women and men across market stalls on the foundational value of education, dismantling the popular misconception that "education is a scam," emphasizing active parental notebook monitoring, and balancing household chores with evening study hours.
            </p>

            <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5 py-1 text-xs">
              <div class="p-2.5 rounded-xl bg-surface-container-lowest border border-outline-variant/30">
                <span class="text-on-surface-variant block text-[10px] uppercase font-bold">Time</span>
                <span class="font-bold text-on-surface">9:00 AM - 11:00 AM</span>
              </div>
              <div class="p-2.5 rounded-xl bg-surface-container-lowest border border-outline-variant/30">
                <span class="text-on-surface-variant block text-[10px] uppercase font-bold">Beneficiaries</span>
                <span class="font-bold text-on-surface">Traders & Shoppers</span>
              </div>
              <div class="p-2.5 rounded-xl bg-surface-container-lowest border border-outline-variant/30 col-span-2 sm:col-span-1">
                <span class="text-on-surface-variant block text-[10px] uppercase font-bold">SDG Target</span>
                <span class="font-bold text-primary">Goal 4: Quality Education</span>
              </div>
            </div>

            <!-- Action Buttons -->
            <div class="pt-2 flex flex-wrap items-center gap-3">
              <a
                href="/blog/ogida-market-quality-education"
                class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-primary hover:bg-primary-container text-on-primary text-xs font-bold shadow-sm transition-all"
              >
                <span>Read in Blog & View All 28 Photos</span>
                <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
              </a>

              <a
                href="/events"
                class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl bg-surface-container-lowest hover:bg-surface-container text-on-surface border border-outline-variant/40 text-xs font-bold shadow-subtle transition-all"
              >
                <span class="material-symbols-outlined text-[16px] text-primary">event_available</span>
                <span>Events Tab</span>
              </a>
            </div>

          </div>

        </div>
      </div>
    </section>

    <!-- Trending Community Ideas for Egor LGA -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
      <div class="bg-surface-container-low/70 p-6 sm:p-8 rounded-3xl border border-outline-variant/30 space-y-6">
        
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
          <div>
            <div class="inline-flex items-center gap-1.5 text-primary text-xs font-bold uppercase tracking-wider mb-1">
              <span class="material-symbols-outlined text-[16px]">forum</span>
              <span>Grassroots Proposals</span>
            </div>
            <h2 class="text-xl sm:text-2xl font-bold text-on-surface">Community Ideas for Egor LGA</h2>
            <p class="text-xs sm:text-sm text-on-surface-variant mt-0.5">
              Review and upvote peer proposals to shape upcoming CDS community projects.
            </p>
          </div>
          <div class="flex items-center gap-3 shrink-0">
            <a
              href="/ideas"
              class="inline-flex items-center gap-1 text-xs sm:text-sm font-bold text-primary hover:underline"
            >
              <span>View All Ideas ({ideas.length})</span>
              <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
            </a>
          </div>
        </div>

        {topIdeas.length === 0 ? (
          <div class="bg-surface-container-lowest rounded-2xl p-8 text-center space-y-3 border border-dashed border-outline-variant max-w-md mx-auto shadow-subtle">
            <div class="w-12 h-12 rounded-xl bg-surface-container text-primary mx-auto flex items-center justify-center text-xl font-bold">
              💡
            </div>
            <h3 class="font-headline-sm text-base font-bold text-on-surface">No Ideas Submitted Yet</h3>
            <p class="font-body-sm text-xs text-on-surface-variant">
              Be the first corps member to drop an anonymous community proposal for Egor LGA.
            </p>
            <div class="pt-1">
              <a
                href="/ideas#drop"
                class="inline-flex items-center gap-1.5 px-5 py-2.5 bg-primary text-on-primary text-xs font-bold rounded-xl shadow-sm hover:bg-primary-container transition-all"
              >
                <span>Submit an Idea</span>
              </a>
            </div>
          </div>
        ) : (
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            {topIdeas.map((idea) => (
              <IdeaCard client:load idea={idea} />
            ))}
          </div>
        )}

      </div>
    </section>

    <!-- UN 17 SDGs Interactive Grid -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full py-4" id="sdg-grid">
      <div class="text-center max-w-2xl mx-auto mb-8 space-y-2">
        <span class="text-xs font-bold text-primary uppercase tracking-wider">
          Global Vision • Local Egor Execution
        </span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-on-surface">
          The 17 Sustainable Development Goals
        </h2>
        <p class="text-xs sm:text-sm text-on-surface-variant">
          Every project planned at the Egor NYSC Secretariat directly maps to one or more of these global targets.
        </p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3">
        {sdgList.map((sdg) => (
          <div
            style={{ backgroundColor: sdg.color }}
            class="group relative rounded-2xl p-4 text-white transition-all hover:scale-[1.02] shadow-subtle min-h-[130px] flex flex-col justify-between"
          >
            <div class="flex justify-between items-start">
              <span class="text-xl font-extrabold opacity-80 font-display">
                {String(sdg.number).padStart(2, '0')}
              </span>
              <span class="material-symbols-outlined text-[18px] opacity-80">public</span>
            </div>
            <div>
              <h5 class="text-xs sm:text-sm font-bold leading-tight">
                {sdg.name}
              </h5>
              <p class="text-[10px] opacity-90 mt-1 line-clamp-1">
                {sdg.shortDescription}
              </p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Understandable Partnership & Action Banner -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full pb-8">
      <div class="bg-primary text-on-primary rounded-3xl p-6 sm:p-10 relative overflow-hidden flex flex-col md:flex-row items-center justify-between gap-6 shadow-card">
        <div class="space-y-2 max-w-xl text-center md:text-left">
          <span class="inline-block px-3 py-1 bg-secondary-container text-on-secondary-container text-xs font-extrabold rounded-full">
            Egor Community Partnership
          </span>
          <h3 class="text-2xl sm:text-3xl font-extrabold leading-tight">
            Want to Collaborate with Egor SDG CDS?
          </h3>
          <p class="text-xs sm:text-sm text-primary-fixed leading-relaxed">
            Whether you represent a local school, business, or you are a serving corps member in Egor LGA, join our Wednesday meeting at the Egor NYSC Secretariat.
          </p>
        </div>

        <div class="flex flex-col sm:flex-row gap-3 shrink-0 w-full md:w-auto">
          <a
            href="/partner"
            class="text-center px-6 py-3 bg-secondary-container hover:bg-secondary-fixed text-on-secondary-container font-bold text-xs sm:text-sm rounded-xl shadow-sm transition-all active:scale-95 flex items-center justify-center gap-1.5"
          >
            <span class="material-symbols-outlined text-[18px]">handshake</span>
            <span>Partner / CSR</span>
          </a>
          <a
            href="/ideas#drop"
            class="text-center px-5 py-3 bg-white/10 hover:bg-white/20 text-white font-bold text-xs sm:text-sm rounded-xl transition-all border border-white/20 active:scale-95"
          >
            Submit an Idea
          </a>
          <a
            href="/admin"
            class="text-center px-4 py-3 bg-white/10 hover:bg-white/20 text-white font-bold text-xs sm:text-sm rounded-xl transition-all border border-white/20 active:scale-95"
          >
            Login 🔒
          </a>
        </div>
      </div>
    </section>

  </div>
</Layout>
