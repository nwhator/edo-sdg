---
import Layout from '../layouts/Layout.astro';
import { fetchIdeas } from '../lib/supabase';
import { SDG_METADATA } from '../types/database';
import { IdeaCard } from '../components/ideas/IdeaCard';

const ideas = await fetchIdeas();
const topIdeas = [...ideas].sort((a, b) => (b.upvotes_count || 0) - (a.upvotes_count || 0)).slice(0, 3);
const sdgList = Object.values(SDG_METADATA);
---

<Layout
  title="Home"
  description="Platform for the Edo State NYSC SDG CDS Group. Propose ideas anonymously, review community needs, and advance sustainable development goals in Edo State."
>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-b from-green-50/70 via-white to-slate-50 border-b border-slate-200/80 overflow-hidden pt-12 pb-20">
    <div class="absolute inset-0 bg-[radial-gradient(#006633_1px,transparent_1px)] [background-size:24px_24px] opacity-10 pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl mx-auto text-center space-y-6">
        
        <!-- Chapter Badge -->
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-nysc-green/10 text-nysc-green-dark border border-nysc-green/20 text-xs font-bold shadow-xs">
          <span class="w-2 h-2 rounded-full bg-nysc-gold animate-ping"></span>
          <span>National Youth Service Corps · Edo State Chapter</span>
        </div>

        <!-- Main Headline -->
        <h1 class="text-4xl sm:text-6xl font-black text-slate-900 tracking-tight leading-[1.1]">
          Advancing Sustainable <span class="text-nysc-green underline decoration-nysc-gold decoration-wavy decoration-2">Development</span> in Edo State
        </h1>

        <!-- Subheading -->
        <p class="text-base sm:text-lg text-slate-600 leading-relaxed font-normal max-w-2xl mx-auto">
          An open platform for NYSC corps members to propose grassroots ideas anonymously, vote on community initiatives, and align with global goals across Benin City and Edo State.
        </p>

        <!-- CTA Buttons -->
        <div class="pt-4 flex flex-wrap items-center justify-center gap-3">
          <a
            href="/ideas"
            class="inline-flex items-center gap-2 px-6 py-3.5 rounded-2xl bg-nysc-green text-white font-extrabold text-sm shadow-lg shadow-nysc-green/30 hover:bg-nysc-green-dark transition-all hover:-translate-y-0.5"
          >
            <svg class="w-4 h-4 text-nysc-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
            </svg>
            <span>Drop Anonymous Idea</span>
          </a>

          <a
            href="/projects"
            class="inline-flex items-center gap-2 px-6 py-3.5 rounded-2xl bg-white text-slate-800 font-bold text-sm border border-slate-300 shadow-xs hover:bg-slate-50 transition-all hover:-translate-y-0.5"
          >
            <span>View Projects</span>
            <span>→</span>
          </a>
        </div>

      </div>

      <!-- Core Process Highlights -->
      <div class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-6 max-w-4xl mx-auto">
        <div class="bg-white/90 backdrop-blur rounded-2xl p-6 border border-slate-200/90 text-center shadow-xs space-y-2">
          <div class="w-10 h-10 rounded-xl bg-green-50 text-nysc-green mx-auto flex items-center justify-center text-lg font-bold">
            1
          </div>
          <h3 class="font-bold text-slate-900 text-sm">Anonymous Proposals</h3>
          <p class="text-xs text-slate-500 leading-relaxed">
            Any corps member can propose community interventions without revealing identity.
          </p>
        </div>

        <div class="bg-white/90 backdrop-blur rounded-2xl p-6 border border-slate-200/90 text-center shadow-xs space-y-2">
          <div class="w-10 h-10 rounded-xl bg-amber-50 text-nysc-gold-dark mx-auto flex items-center justify-center text-lg font-bold">
            2
          </div>
          <h3 class="font-bold text-slate-900 text-sm">Peer Democracy</h3>
          <p class="text-xs text-slate-500 leading-relaxed">
            Members review and upvote solutions with the highest potential local impact.
          </p>
        </div>

        <div class="bg-white/90 backdrop-blur rounded-2xl p-6 border border-slate-200/90 text-center shadow-xs space-y-2">
          <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-800 mx-auto flex items-center justify-center text-lg font-bold">
            3
          </div>
          <h3 class="font-bold text-slate-900 text-sm">Executive Review</h3>
          <p class="text-xs text-slate-500 leading-relaxed">
            Approved concepts undergo budgeting and outreach through the admin portal.
          </p>
        </div>
      </div>

    </div>
  </section>

  <!-- Community Ideas Section -->
  <section class="py-16 bg-slate-50 border-b border-slate-200/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
      
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-nysc-green">Grassroots Voice</span>
          <h2 class="text-2xl sm:text-4xl font-black text-slate-900 tracking-tight mt-1">
            Community Ideas Hub
          </h2>
          <p class="text-xs sm:text-sm text-slate-500 mt-1">
            Submitted anonymously by Edo State corps members.
          </p>
        </div>
        <a
          href="/ideas"
          class="inline-flex items-center gap-1 text-xs font-bold text-nysc-green hover:underline self-start sm:self-auto"
        >
          <span>View All Ideas</span>
          <span>→</span>
        </a>
      </div>

      {topIdeas.length === 0 ? (
        <div class="bg-white rounded-3xl border border-dashed border-slate-300 p-12 text-center space-y-4 max-w-xl mx-auto shadow-xs">
          <div class="w-14 h-14 rounded-2xl bg-amber-50 text-nysc-gold-dark mx-auto flex items-center justify-center text-2xl">
            💡
          </div>
          <h3 class="text-lg font-bold text-slate-900">No Ideas Submitted Yet</h3>
          <p class="text-xs text-slate-500 leading-relaxed">
            Be the first corps member to share an anonymous community development idea for Edo State.
          </p>
          <div>
            <a
              href="/ideas"
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-nysc-green text-white text-xs font-bold shadow-xs hover:bg-nysc-green-dark transition-all"
            >
              <span>Submit First Idea</span>
              <span>→</span>
            </a>
          </div>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {topIdeas.map((idea) => (
            <IdeaCard client:load idea={idea} />
          ))}
        </div>
      )}

    </div>
  </section>

  <!-- 17 Goals Matrix -->
  <section class="py-16 bg-slate-900 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
      
      <div class="text-center max-w-2xl mx-auto space-y-2">
        <span class="text-xs font-bold uppercase tracking-wider text-nysc-gold">Framework</span>
        <h2 class="text-2xl sm:text-4xl font-black text-white tracking-tight">
          17 Global Goals
        </h2>
        <p class="text-xs sm:text-sm text-slate-400">
          Our CDS initiatives align with these focus areas across Edo State.
        </p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3">
        {sdgList.map((sdg) => (
          <div
            style={{ borderTopColor: sdg.color }}
            class="bg-white/5 border border-white/10 rounded-2xl p-4 border-t-4 hover:bg-white/10 transition-colors space-y-2"
          >
            <div class="flex items-center justify-between">
              <span
                style={{ backgroundColor: sdg.color }}
                class="w-7 h-7 rounded-lg text-white font-black text-xs flex items-center justify-center shadow-xs"
              >
                {sdg.number}
              </span>
            </div>
            <h4 class="text-xs font-bold text-white line-clamp-1">{sdg.name}</h4>
            <p class="text-[10px] text-slate-400 line-clamp-2 leading-relaxed">
              {sdg.shortDescription}
            </p>
          </div>
        ))}
      </div>

    </div>
  </section>
</Layout>
