---
import Layout from '../../layouts/Layout.astro';
import { EventGallery } from '../../components/gallery/EventGallery';
import { fetchEvents } from '../../lib/supabase';

const { events, photos } = await fetchEvents();
---

<Layout
  title="Event Photo Gallery & Community Outreaches"
  description="Visual record of Edo State NYSC SDG community outreaches, school workshops, and sanitation drives grouped by event."
>
  <div class="max-w-7xl mx-auto px-margin-mobile md:px-margin-desktop py-space-xl">
    <EventGallery client:load events={events} photos={photos} />
  </div>
</Layout>
