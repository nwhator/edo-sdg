---
import Layout from '../../layouts/Layout.astro';
import { fetchEvents } from '../../lib/supabase';
import { BlogPhotoGrid } from '../../components/blog/BlogPhotoGrid';

const { events, photos } = await fetchEvents();
const thisEvent = events.find((e) => e.id === 'evt-nov11-weekly-meeting-biodigester-babyvisit') || {
  id: 'evt-nov11-weekly-meeting-biodigester-babyvisit',
  title: 'Minutes of the SDG CDS Meeting (Nov 11, 2026)',
  event_date: '2026-11-11',
  event_time: '9:00 AM - 1:00 PM',
  location: 'Egor NYSC Secretariat, Benin City, Edo State',
  week: 'Week 6',
  quarter: '4th Quarter',
  sdg_goals: [7, 11, 12, 3, 17],
};

const thisPhotos = photos.filter(
  (p) => p.event_id === 'evt-nov11-weekly-meeting-biodigester-babyvisit' || p.image_url.includes('nov11_babyvisit')
);

// Group photos by category for intuitive exploration
const newcomerPhotos = thisPhotos.filter((p) => p.image_url.includes('newcomers'));
const biodigesterPhotos = thisPhotos.filter((p) => p.image_url.includes('biodigester'));
const babyPhotos = thisPhotos.filter((p) => p.image_url.includes('baby_'));
const sdgPhotos = thisPhotos.filter((p) => p.image_url.includes('sdg_'));

const siteUrl = 'https://edo-sdg.vercel.app';
const articleUrl = `${siteUrl}/blog/minutes-sdg-cds-meeting-nov-11-2026`;
const videoUrl = `${siteUrl}/nov11_babyvisit/complilation.mp4`;
const thumbnailUrl = `${siteUrl}/nov11_babyvisit/compilation-thumbnail.jpg`;

const articleSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "NewsArticle",
      "@id": `${articleUrl}#article`,
      "isPartOf": {
        "@type": "WebSite",
        "@id": `${siteUrl}#website`,
        "name": "NYSC Egor SDG CDS Platform",
        "url": siteUrl
      },
      "headline": "Official Minutes of the SDG CDS Meeting (November 11, 2026) - NYSC Egor LGA",
      "image": [
        thumbnailUrl,
        `${siteUrl}/nov11_babyvisit/sdg_01.jpg`
      ],
      "datePublished": "2026-11-11T09:00:00+01:00",
      "dateModified": "2026-11-12T19:00:00+01:00",
      "author": {
        "@type": "Organization",
        "name": "NYSC Egor SDG Community Development Service (CDS) Group",
        "url": siteUrl
      },
      "publisher": {
        "@type": "Organization",
        "name": "National Youth Service Corps (NYSC) Nigeria",
        "url": "https://www.nysc.gov.ng"
      },
      "description": "Itemized official minutes and resolutions from the NYSC Egor SDG CDS meeting held on 11th November 2026: Uwelu Market environmental sanitation relocation, colleague welfare baby visit, biodigester technical repair roadmap for January, SDG website launch, POP honors, and December 5 picnic group colors.",
      "articleSection": "Community Development Service",
      "inLanguage": "en-NG",
      "about": [
        { "@type": "Thing", "name": "Sustainable Development Goal 7: Affordable and Clean Energy" },
        { "@type": "Thing", "name": "Sustainable Development Goal 11: Sustainable Cities and Communities" },
        { "@type": "Thing", "name": "Sustainable Development Goal 3: Good Health and Well-being" },
        { "@type": "Thing", "name": "Sustainable Development Goal 12: Responsible Consumption and Production" },
        { "@type": "Place", "name": "Egor NYSC Secretariat, Benin City, Edo State" }
      ]
    },
    {
      "@type": "VideoObject",
      "@id": `${articleUrl}#video`,
      "name": "NYSC Egor SDG CDS Weekly Meeting & Welfare Outreach Compilation Video",
      "description": "Comprehensive video compilation of the November 11, 2026 CDS meeting: welcoming newcomers, school biodigester project evaluation, and member welfare baby visit.",
      "thumbnailUrl": [
        thumbnailUrl
      ],
      "uploadDate": "2026-11-11T12:00:00+01:00",
      "duration": "PT38S",
      "contentUrl": videoUrl,
      "embedUrl": articleUrl
    }
  ]
};
---

<Layout
  title="Minutes of the SDG CDS Meeting (Nov 11, 2026) • Compilation Video & Resolutions • NYSC Egor"
  description="Official minutes of the NYSC Egor SDG CDS meeting held on November 11, 2026: welcoming newcomers, Uwelu Market sanitation, colleague welfare baby visit, website launch, POP honors, biodigester roadmap for January, and December 5 picnic colors."
  image="/nov11_babyvisit/compilation-thumbnail.jpg"
  video="/nov11_babyvisit/complilation.mp4"
  videoWidth={464}
  videoHeight={832}
  type="article"
>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} slot="head" />

  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-14 space-y-10">
    
    <!-- Breadcrumb & Top Bar -->
    <nav class="flex items-center gap-2 text-xs text-on-surface-variant font-medium">
      <a href="/" class="hover:text-primary transition-colors">Home</a>
      <span>/</span>
      <a href="/blog" class="hover:text-primary transition-colors">Blog</a>
      <span>/</span>
      <span class="text-primary font-bold">Minutes: SDG CDS Meeting (Nov 11, 2026)</span>
    </nav>

    <!-- Official Verified Sign-Off Banner -->
    <div class="p-4 sm:p-5 rounded-2xl bg-[#004b24]/10 border border-[#004b24]/30 flex items-start gap-3.5 text-on-surface shadow-xs">
      <div class="w-9 h-9 rounded-xl bg-[#004b24]/20 text-[#004b24] dark:text-[#4C9F38] flex items-center justify-center shrink-0 font-bold">
        <span class="material-symbols-outlined text-[20px]">verified</span>
      </div>
      <div class="space-y-1 flex-1">
        <div class="flex flex-wrap items-center gap-2">
          <span class="px-2 py-0.5 rounded-md bg-[#004b24] text-white text-[10px] font-black uppercase tracking-wider">
            Official Minutes
          </span>
          <span class="text-xs font-bold text-on-surface">
            Formal Meeting Record & Resolutions Adopted by the General Assembly
          </span>
        </div>
        <p class="text-xs text-on-surface-variant leading-relaxed">
          National Youth Service Corps (NYSC) • Egor Local Government Area, Edo State • Meeting convened on Wednesday, 11th November 2026 at the Egor Secretariat, Benin City.
        </p>
      </div>
    </div>

    <!-- Main Header -->
    <header class="space-y-5 border-b border-surface-container pb-8">
      <div class="flex flex-wrap items-center gap-2">
        <span class="px-3 py-1 rounded-full bg-[#FCC30B] text-black text-xs font-black shadow-xs">
          SDG 7: Clean Energy
        </span>
        <span class="px-3 py-1 rounded-full bg-[#FD9D24] text-white text-xs font-black shadow-xs">
          SDG 11: Sustainable Communities
        </span>
        <span class="px-3 py-1 rounded-full bg-[#4C9F38] text-white text-xs font-black shadow-xs">
          SDG 3: Health & Welfare
        </span>
        <span class="px-3 py-1 rounded-full bg-[#BF8B2E] text-white text-xs font-black shadow-xs">
          SDG 12: Responsible Consumption
        </span>
        <span class="px-3 py-1 rounded-full bg-surface-container text-primary text-xs font-bold">
          Week 6 • 4th Quarter
        </span>
      </div>

      <h1 class="text-2xl sm:text-4xl font-extrabold text-on-surface tracking-tight leading-tight">
        MINUTES OF THE SDG CDS MEETING
      </h1>
      <p class="text-base sm:text-lg text-primary font-bold">
        Egor Local Government Area, Benin City • Wednesday, November 11, 2026
      </p>

      <!-- Executive Overview Card -->
      <div class="p-4 sm:p-5 rounded-2xl bg-surface-container-lowest border border-surface-container grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 text-xs">
        <div>
          <span class="text-[10px] uppercase font-bold text-on-surface-variant tracking-wider block">Meeting Date</span>
          <span class="font-bold text-on-surface flex items-center gap-1.5 mt-0.5">
            <span class="material-symbols-outlined text-[15px] text-primary">calendar_today</span>
            November 11, 2026
          </span>
        </div>
        <div>
          <span class="text-[10px] uppercase font-bold text-on-surface-variant tracking-wider block">Venue</span>
          <span class="font-bold text-on-surface flex items-center gap-1.5 mt-0.5">
            <span class="material-symbols-outlined text-[15px] text-primary">location_on</span>
            Egor NYSC Secretariat
          </span>
        </div>
        <div>
          <span class="text-[10px] uppercase font-bold text-on-surface-variant tracking-wider block">Presiding Leadership</span>
          <span class="font-bold text-on-surface flex items-center gap-1.5 mt-0.5">
            <span class="material-symbols-outlined text-[15px] text-primary">badge</span>
            President & Executive Council
          </span>
        </div>
        <div>
          <span class="text-[10px] uppercase font-bold text-on-surface-variant tracking-wider block">Attendance</span>
          <span class="font-bold text-on-surface flex items-center gap-1.5 mt-0.5">
            <span class="material-symbols-outlined text-[15px] text-primary">groups</span>
            Serving Corps Members & Newcomers
          </span>
        </div>
      </div>

      <!-- Quick Social Sharing Bar -->
      <div class="pt-2 flex flex-wrap items-center justify-between gap-3 border-t border-surface-container/60">
        <div class="flex items-center gap-2">
          <span class="text-xs font-bold text-on-surface-variant">Share Minutes:</span>
          <!-- WhatsApp Share -->
          <a
            href={`https://wa.me/?text=${encodeURIComponent('Official Minutes & Video Highlights of the NYSC Egor SDG CDS Meeting (Nov 11, 2026): https://edo-sdg.vercel.app/blog/minutes-sdg-cds-meeting-nov-11-2026')}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-[#25D366]/10 hover:bg-[#25D366]/20 text-[#128C7E] dark:text-[#25D366] text-xs font-bold transition-all border border-[#25D366]/30"
          >
            <span class="material-symbols-outlined text-[15px]">share</span>
            <span>WhatsApp</span>
          </a>
          <!-- Twitter / X Share -->
          <a
            href={`https://twitter.com/intent/tweet?text=${encodeURIComponent('Minutes of the NYSC Egor SDG CDS Meeting (Nov 11, 2026): Uwelu Market Sanitation, Biodigester Project & Welfare Visit.')}&url=${encodeURIComponent('https://edo-sdg.vercel.app/blog/minutes-sdg-cds-meeting-nov-11-2026')}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-surface-container text-on-surface text-xs font-bold hover:bg-surface-container-high transition-all border border-surface-container-high"
          >
            <span>X (Twitter)</span>
          </a>
          <!-- Copy Link -->
          <button
            type="button"
            onclick="navigator.clipboard.writeText('https://edo-sdg.vercel.app/blog/minutes-sdg-cds-meeting-nov-11-2026'); alert('Official meeting minutes link copied to clipboard!');"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-surface-container text-on-surface text-xs font-bold hover:bg-surface-container-high transition-all border border-surface-container-high"
          >
            <span class="material-symbols-outlined text-[15px]">content_copy</span>
            <span>Copy Link</span>
          </button>
        </div>

        <div class="flex items-center gap-2">
          <a
            href="#agenda-items"
            class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl bg-primary text-on-primary text-xs font-bold hover:opacity-90 transition-all shadow-xs"
          >
            <span class="material-symbols-outlined text-[15px]">list_alt</span>
            <span>Jump to 8 Agendas</span>
          </a>
        </div>
      </div>
    </header>

    <!-- SECTION 1: Featured Main Compilation Video (complilation.mp4) -->
    <section id="compilation-video" class="bg-surface-container-low p-6 sm:p-8 rounded-3xl border border-surface-container space-y-5 shadow-sm">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-surface-container pb-3">
        <div>
          <span class="inline-flex items-center gap-1.5 text-xs font-bold text-primary uppercase tracking-wider">
            <span class="material-symbols-outlined text-[18px]">movie</span>
            <span>Official Event Compilation Video</span>
          </span>
          <h2 class="text-xl sm:text-2xl font-extrabold text-on-surface">
            Meeting Highlights & Field Outreach Reel
          </h2>
        </div>
        <span class="px-3 py-1 rounded-full bg-primary/10 text-primary text-xs font-bold self-start sm:self-auto flex items-center gap-1.5">
          <span class="material-symbols-outlined text-[15px]">videocam</span>
          <span>complilation.mp4 • 0:38 HD</span>
        </span>
      </div>

      <!-- Enhanced Dual Column Video Presentation -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-center">
        <!-- Video Player Column -->
        <div class="md:col-span-5 flex justify-center">
          <div class="relative w-full max-w-[320px] aspect-[464/832] rounded-3xl overflow-hidden bg-black shadow-elevated border-2 border-primary/20">
            <video
              controls
              playsinline
              preload="metadata"
              poster="/nov11_babyvisit/compilation-poster.jpg"
              class="w-full h-full object-cover bg-black"
            >
              <source src="/nov11_babyvisit/complilation.mp4" type="video/mp4" />
              Your browser does not support the video tag.
            </video>
          </div>
        </div>

        <!-- Video Context & Breakdown Column -->
        <div class="md:col-span-7 space-y-4">
          <div class="space-y-2">
            <span class="px-2.5 py-1 rounded-md bg-[#004b24] text-white text-[11px] font-bold uppercase tracking-wider">
              Featured Coverage
            </span>
            <h3 class="text-lg sm:text-xl font-bold text-on-surface">
              Comprehensive 38-Second CDS Highlights
            </h3>
            <p class="text-xs sm:text-sm text-on-surface-variant leading-relaxed text-justify">
              Official video compilation capturing the essence of the 11th November 2026 meeting: from the welcome reception of newly deployed corps members at the Egor NYSC Secretariat, to technical project review of the community biodigester, through to the heartwarming moments of our delegation visiting our colleague to celebrate her new baby.
            </p>
          </div>

          <!-- Quick Actions -->
          <div class="pt-1 flex flex-wrap items-center gap-2 text-xs">
            <a
              href="/nov11_babyvisit/complilation.mp4"
              download="NYSC_Egor_SDG_CDS_Compilation_Nov11_2026.mp4"
              class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-surface-container-high hover:bg-surface-container text-on-surface font-bold border border-surface-container-highest transition-all"
            >
              <span class="material-symbols-outlined text-[16px] text-primary">download</span>
              <span>Download Video (6.3 MB)</span>
            </a>
            <span class="text-on-surface-variant text-[11px] flex items-center gap-1">
              <span class="material-symbols-outlined text-[14px]">smartphone</span>
              Mobile-optimized vertical format
            </span>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 2: Sub-Videos from the Baby Visit -->
    <section class="bg-surface-container-lowest p-6 sm:p-8 rounded-3xl border border-surface-container space-y-5">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-surface-container pb-3">
        <div>
          <span class="text-xs font-bold text-[#4C9F38] uppercase tracking-wider block">Welfare & Solidarity Clips (SDG 3)</span>
          <h3 class="text-lg sm:text-xl font-bold text-on-surface">Moments from the Colleague Baby Visit</h3>
          <p class="text-xs text-on-surface-variant mt-0.5">
            Short video recordings documented during our welfare delegation visit following the monetization of the welfare gift.
          </p>
        </div>
        <span class="px-3 py-1 rounded-full bg-[#4C9F38]/10 text-[#4C9F38] text-xs font-bold self-start sm:self-auto">
          3 Video Clips
        </span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <!-- Clip 1 -->
        <div class="space-y-2 bg-surface-container-low p-3.5 rounded-2xl border border-surface-container">
          <div class="relative aspect-9/16 max-h-[360px] mx-auto rounded-xl overflow-hidden bg-black shadow-xs">
            <video
              controls
              playsinline
              preload="metadata"
              poster="/nov11_babyvisit/baby_01.jpg"
              class="w-full h-full object-cover bg-black"
            >
              <source src="/nov11_babyvisit/babyvideo_01.mp4" type="video/mp4" />
              Your browser does not support video.
            </video>
          </div>
          <p class="text-[11px] font-bold text-on-surface text-center line-clamp-1">Arrival & Greetings (Clip 1)</p>
        </div>

        <!-- Clip 2 -->
        <div class="space-y-2 bg-surface-container-low p-3.5 rounded-2xl border border-surface-container">
          <div class="relative aspect-9/16 max-h-[360px] mx-auto rounded-xl overflow-hidden bg-black shadow-xs">
            <video
              controls
              playsinline
              preload="metadata"
              poster="/nov11_babyvisit/baby_03.jpg"
              class="w-full h-full object-cover bg-black"
            >
              <source src="/nov11_babyvisit/babyvideo_02.mp4" type="video/mp4" />
              Your browser does not support video.
            </video>
          </div>
          <p class="text-[11px] font-bold text-on-surface text-center line-clamp-1">Presentation & Smiles (Clip 2)</p>
        </div>

        <!-- Clip 3 -->
        <div class="space-y-2 bg-surface-container-low p-3.5 rounded-2xl border border-surface-container">
          <div class="relative aspect-9/16 max-h-[360px] mx-auto rounded-xl overflow-hidden bg-black shadow-xs">
            <video
              controls
              playsinline
              preload="metadata"
              poster="/nov11_babyvisit/baby_05.jpg"
              class="w-full h-full object-cover bg-black"
            >
              <source src="/nov11_babyvisit/babyvideo_03.mp4" type="video/mp4" />
              Your browser does not support video.
            </video>
          </div>
          <p class="text-[11px] font-bold text-on-surface text-center line-clamp-1">Goodwill & Prayers (Clip 3)</p>
        </div>
      </div>
    </section>

    <!-- SECTION 3: OFFICIAL ITEMIZED MINUTES (THE 8 AGENDAS) -->
    <section id="agenda-items" class="space-y-8 text-on-surface">
      
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-surface-container pb-4">
        <div>
          <span class="text-xs font-bold text-primary uppercase tracking-wider block">
            Itemized Parliamentary Record
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-on-surface">
            Official Minutes of the Meeting
          </h2>
        </div>
        <div class="flex items-center gap-2">
          <span class="px-3 py-1 rounded-full bg-surface-container text-on-surface text-xs font-bold">
            8 Substantive Agendas
          </span>
        </div>
      </div>

      <!-- Quick Navigation Chips for the 8 Agendas -->
      <div class="p-3.5 rounded-2xl bg-surface-container-lowest border border-surface-container flex flex-wrap gap-1.5 text-xs font-bold">
        <a href="#agenda-1" class="px-2.5 py-1 rounded-lg bg-surface-container-high hover:bg-primary hover:text-white transition-colors">1. Introductions</a>
        <a href="#agenda-2" class="px-2.5 py-1 rounded-lg bg-surface-container-high hover:bg-primary hover:text-white transition-colors">2. Uwelu Sanitation</a>
        <a href="#agenda-3" class="px-2.5 py-1 rounded-lg bg-surface-container-high hover:bg-primary hover:text-white transition-colors">3. Welfare Baby Visit</a>
        <a href="#agenda-4" class="px-2.5 py-1 rounded-lg bg-surface-container-high hover:bg-primary hover:text-white transition-colors">4. Financial Report</a>
        <a href="#agenda-5" class="px-2.5 py-1 rounded-lg bg-surface-container-high hover:bg-primary hover:text-white transition-colors">5. SDG Website</a>
        <a href="#agenda-6" class="px-2.5 py-1 rounded-lg bg-surface-container-high hover:bg-primary hover:text-white transition-colors">6. POP Gifts & Certs</a>
        <a href="#agenda-7" class="px-2.5 py-1 rounded-lg bg-surface-container-high hover:bg-primary hover:text-white transition-colors">7. Biodigester Project</a>
        <a href="#agenda-8" class="px-2.5 py-1 rounded-lg bg-surface-container-high hover:bg-primary hover:text-white transition-colors">8. Dec 5 Picnic (5 Colors)</a>
      </div>

      <div class="space-y-6">
        
        <!-- AGENDA 1 -->
        <article id="agenda-1" class="p-6 sm:p-7 rounded-3xl bg-surface-container-lowest border border-surface-container shadow-subtle space-y-3.5">
          <div class="flex flex-wrap items-center justify-between gap-2 border-b border-surface-container pb-3">
            <div class="flex items-center gap-3">
              <span class="w-8 h-8 rounded-xl bg-primary text-on-primary flex items-center justify-center font-bold text-sm">
                1
              </span>
              <h3 class="text-lg sm:text-xl font-bold text-on-surface">
                Opening and Introductions
              </h3>
            </div>
            <span class="px-2.5 py-0.5 rounded-full bg-primary/10 text-primary text-xs font-bold">
              General Assembly & Orientation
            </span>
          </div>

          <p class="text-sm sm:text-base text-on-surface leading-relaxed text-justify">
            The President formally called the meeting to order and warmly welcomed the newly deployed National Youth Service Corps (NYSC) members to the SDG CDS group. To foster integration and camaraderie, the President asked each newcomer to introduce themselves to the house, stating their background and disciplines. Following the newcomers' introductions, the President also called upon the Executive Committee (Exco) members to introduce themselves, delineating their executive portfolios and leadership duties to the house.
          </p>

          <div class="p-3.5 rounded-xl bg-surface-container-low border border-surface-container text-xs text-on-surface-variant flex items-center gap-2">
            <span class="material-symbols-outlined text-primary text-[18px]">how_to_reg</span>
            <span><strong>Outcome:</strong> Seamless induction of new corps members into the group; Exco roles clarified for direct administrative support.</span>
          </div>
        </article>

        <!-- AGENDA 2 -->
        <article id="agenda-2" class="p-6 sm:p-7 rounded-3xl bg-surface-container-lowest border border-surface-container shadow-subtle space-y-3.5">
          <div class="flex flex-wrap items-center justify-between gap-2 border-b border-surface-container pb-3">
            <div class="flex items-center gap-3">
              <span class="w-8 h-8 rounded-xl bg-[#FD9D24] text-white flex items-center justify-center font-bold text-sm">
                2
              </span>
              <h3 class="text-lg sm:text-xl font-bold text-on-surface">
                Market Environmental Sanitation Exercise
              </h3>
            </div>
            <div class="flex items-center gap-2">
              <span class="px-2.5 py-0.5 rounded-full bg-[#FD9D24]/10 text-[#FD9D24] text-xs font-bold">
                SDG 11: Sustainable Communities
              </span>
              <span class="px-2.5 py-0.5 rounded-full bg-[#4C9F38]/10 text-[#4C9F38] text-xs font-bold">
                SDG 3: Good Health
              </span>
            </div>
          </div>

          <p class="text-sm sm:text-base text-on-surface leading-relaxed text-justify">
            The house was informed that the previously planned environmental sanitation exercise at <strong>Oliha Market</strong> was canceled because Oliha Market is geographically and administratively located under <strong>Oredo Local Government Area</strong> rather than <strong>Egor Local Government Area</strong>. Following deliberative discussions on maintaining jurisdiction and grassroots community impact within Egor LGA, it was suggested and unanimously agreed upon by the house to conduct the environmental sanitation exercise at <strong>Uwelu Market</strong> on next week's Wednesday (November 18, 2026).
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1 text-xs">
            <div class="p-3 rounded-xl bg-red-500/10 border border-red-500/20 text-on-surface">
              <span class="font-bold text-red-700 dark:text-red-400 block mb-0.5">Oliha Market (Canceled)</span>
              <span>Jurisdiction: Oredo LGA (outside group jurisdiction).</span>
            </div>
            <div class="p-3 rounded-xl bg-green-500/10 border border-green-500/20 text-on-surface">
