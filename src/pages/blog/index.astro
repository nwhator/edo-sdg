---
import Layout from '../../layouts/Layout.astro';
import { fetchEvents } from '../../lib/supabase';

const { events, photos } = await fetchEvents();
const ogidaEvent = events.find((e) => e.id === 'evt-ogida-education-sensitization') || events[0];
const ogidaPhotos = photos.filter((p) => p.event_id === ogidaEvent?.id || p.event_id === 'evt-ogida-education-sensitization');

const blogPosts = [
  {
    slug: 'ogida-market-quality-education',
    title: 'Sensitization on the Importance of Quality Education (SDG 4) and Parental Involvement at Ogida Market, Benin City',
    date: 'Wednesday, 21st October, 2026',
    time: '9:00 AM - 11:00 AM',
    quarter: 'Week 3 • 4th Quarter',
    location: 'Ogida Market, Benin City, Egor LGA',
    sdgGoal: 4,
    sdgName: 'Quality Education',
    category: 'Field Outreach',
    readTime: '4 min read',
    coverImage: '/ogida/1.jpg',
    excerpt: 'Sensitizing market women and men on SDG 4 (Quality Education), dismantling the misconception that "education is a scam," encouraging active parental homework checks, and balancing market chores with home study hours.',
    photosCount: ogidaPhotos.length || 37,
    hasVideo: true,
  }
];
---

<Layout
  title="Blog & Field Stories • NYSC Egor SDG CDS Group"
  description="Official articles, field outreach stories, and educational reports by the NYSC Sustainable Development Goals (SDG) CDS Group in Egor Local Government Area."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-14 space-y-12">
    
    <!-- Top Header -->
    <div class="text-center max-w-3xl mx-auto space-y-3">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-primary/10 text-primary text-xs font-bold uppercase tracking-wider">
        <span class="material-symbols-outlined text-[16px]">newspaper</span>
        <span>Egor NYSC Secretariat • Field Stories & Articles</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-on-surface tracking-tight">
        SDG Impact <span class="text-primary">Blog & Stories</span>
      </h1>
      <p class="text-sm sm:text-base text-on-surface-variant max-w-2xl mx-auto leading-relaxed">
        Read detailed reports, educational campaigns, and grassroots community engagements led by NYSC corps members across Egor Local Government Area.
      </p>

      <!-- Quick Action Buttons -->
      <div class="pt-2 flex flex-wrap items-center justify-center gap-3">
        <a
          href="/events"
          class="inline-flex items-center gap-1.5 px-5 py-2.5 rounded-xl bg-primary hover:bg-primary-container text-on-primary text-xs font-bold shadow-sm transition-all"
        >
          <span class="material-symbols-outlined text-[16px]">event_available</span>
          <span>View Events & Photo Gallery →</span>
        </a>
      </div>
    </div>

    <!-- Featured Lead Story (Ogida Market Sensitization) -->
    <section class="max-w-5xl mx-auto">
      {blogPosts.map((post) => (
        <article class="bg-surface-container-lowest rounded-3xl border border-primary/20 shadow-elevated overflow-hidden grid grid-cols-1 md:grid-cols-12 gap-0 group">
          
          <!-- Image -->
          <div class="md:col-span-6 relative aspect-16/10 md:aspect-auto overflow-hidden bg-surface-container">
            <img
              src={post.coverImage}
              alt={post.title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent md:hidden"></div>
            <div class="absolute top-4 left-4 flex flex-wrap gap-2">
              <span class="px-3 py-1 rounded-full bg-[#C5192D] text-white text-[11px] font-black shadow-sm">
                SDG {post.sdgGoal}: {post.sdgName}
              </span>
              <span class="px-2.5 py-1 rounded-full bg-surface-container-lowest/90 backdrop-blur text-on-surface text-[11px] font-bold">
                {post.quarter}
              </span>
              {post.hasVideo && (
                <span class="px-2.5 py-1 rounded-full bg-primary text-white text-[11px] font-bold shadow-sm flex items-center gap-1">
                  <span class="material-symbols-outlined text-[13px]">videocam</span>
                  <span>Video Included</span>
                </span>
              )}
            </div>
            <div class="absolute bottom-3 left-4 text-white text-xs font-semibold flex items-center gap-1.5">
              <span class="material-symbols-outlined text-[16px] text-tertiary">photo_camera</span>
              <span>{post.photosCount} Captured Photos</span>
            </div>
          </div>

          <!-- Content -->
          <div class="md:col-span-6 p-6 sm:p-8 flex flex-col justify-between space-y-4">
            <div class="space-y-3">
              <div class="flex items-center justify-between text-xs text-on-surface-variant font-medium">
                <span class="text-primary font-bold uppercase tracking-wider">{post.category}</span>
                <span>{post.readTime}</span>
              </div>

              <h2 class="text-xl sm:text-2xl font-extrabold text-on-surface group-hover:text-primary transition-colors leading-snug">
                <a href={`/blog/${post.slug}`}>
                  {post.title}
                </a>
              </h2>

              <p class="text-xs sm:text-sm text-on-surface-variant leading-relaxed text-justify line-clamp-4">
                {post.excerpt}
              </p>

              <div class="text-xs text-on-surface-variant space-y-1 pt-1 border-t border-surface-container">
                <div class="flex items-center gap-1.5 font-medium">
                  <span class="material-symbols-outlined text-[15px] text-primary">calendar_today</span>
                  <span>{post.date} • {post.time}</span>
                </div>
                <div class="flex items-center gap-1.5 font-medium">
                  <span class="material-symbols-outlined text-[15px] text-primary">location_on</span>
                  <span>{post.location}</span>
                </div>
              </div>
            </div>

            <!-- Actions -->
            <div class="pt-2 flex flex-wrap items-center gap-3">
              <a
                href={`/blog/${post.slug}`}
                class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-primary hover:bg-primary-container text-on-primary text-xs font-bold shadow-sm transition-all"
              >
                <span>Read Full Story & View {post.photosCount} Photos</span>
                <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
              </a>
            </div>

          </div>

        </article>
      ))}
    </section>

    <!-- Additional Community Notice Section -->
    <section class="max-w-5xl mx-auto p-6 sm:p-8 rounded-3xl bg-surface-container-low border border-surface-container text-center space-y-3">
      <div class="w-12 h-12 rounded-2xl bg-surface-container text-primary mx-auto flex items-center justify-center font-bold text-2xl">
        📢
      </div>
      <h3 class="text-lg font-bold text-on-surface">Community Publishing Guidelines</h3>
      <p class="text-xs sm:text-sm text-on-surface-variant max-w-xl mx-auto leading-relaxed">
        All field stories and sensitization summaries published on this blog are vetted by the NYSC Egor SDG CDS Editorial Committee and President Augusta, ensuring direct alignment with the UN 2030 Agenda and community impact standards.
      </p>
    </section>

  </div>
</Layout>
