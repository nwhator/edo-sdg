---
import Layout from '../../layouts/Layout.astro';
import { fetchEvents } from '../../lib/supabase';
import { BlogPhotoGrid } from '../../components/blog/BlogPhotoGrid';

const { events, photos } = await fetchEvents();
const thisEvent = events.find((e) => e.id === 'evt-nov11-weekly-meeting-biodigester-babyvisit') || {
  id: 'evt-nov11-weekly-meeting-biodigester-babyvisit',
  title: 'Weekly CDS Meeting: Newcomers Reception, Biodigester Project Progress & Solidarity Baby Visit',
  event_date: '2026-11-11',
  event_time: '9:00 AM',
  location: 'Egor NYSC Secretariat, Benin City, Edo State',
  week: 'Week 6',
  quarter: '4th Quarter',
  sdg_goals: [7, 12, 3, 17],
};

const thisPhotos = photos.filter(
  (p) => p.event_id === 'evt-nov11-weekly-meeting-biodigester-babyvisit' || p.image_url.includes('nov11_babyvisit')
);

// Group photos by category for intuitive exploration
const newcomerPhotos = thisPhotos.filter((p) => p.image_url.includes('newcomers'));
const biodigesterPhotos = thisPhotos.filter((p) => p.image_url.includes('biodigester'));
const babyPhotos = thisPhotos.filter((p) => p.image_url.includes('baby_'));
const sdgPhotos = thisPhotos.filter((p) => p.image_url.includes('sdg_'));

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  "headline": "Weekly CDS Meeting: Newcomers Reception, Biodigester Project Progress & Solidarity Baby Visit",
  "image": [
    "https://edo-sdg.vercel.app/nov11_babyvisit/sdg_01.jpg"
  ],
  "datePublished": "2026-11-11T09:00:00+01:00",
  "dateModified": "2026-11-12T11:00:00+01:00",
  "author": {
    "@type": "Organization",
    "name": "NYSC Egor SDG Community Development Service (CDS) Group",
    "url": "https://edo-sdg.vercel.app"
  },
  "publisher": {
    "@type": "Organization",
    "name": "National Youth Service Corps (NYSC) Nigeria",
    "url": "https://www.nysc.gov.ng"
  },
  "description": "Weekly meeting of NYSC Egor SDG CDS: welcoming newly deployed corps members, progress update on the school biodigester project (SDG 7 & 12), and a solidarity welfare baby visit to our colleague.",
  "about": [
    { "@type": "Thing", "name": "Sustainable Development Goal 7: Affordable and Clean Energy" },
    { "@type": "Thing", "name": "Sustainable Development Goal 12: Responsible Consumption and Production" },
    { "@type": "Thing", "name": "Sustainable Development Goal 3: Good Health and Well-being" },
    { "@type": "Place", "name": "Egor NYSC Secretariat, Benin City, Edo State" }
  ]
};
---

<Layout
  title="Weekly CDS Meeting (Nov 11) • Biodigester & Baby Visit • NYSC Egor Blog"
  description="Coverage of NYSC Egor SDG CDS meeting held on 11/11/2026: welcoming newcomers, biodigester clean energy updates, and solidarity welfare baby visit."
  image="/nov11_babyvisit/sdg_01.jpg"
  type="article"
>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} slot="head" />

  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-14 space-y-10">
    
    <!-- Breadcrumb & Top Bar -->
    <nav class="flex items-center gap-2 text-xs text-on-surface-variant font-medium">
      <a href="/" class="hover:text-primary transition-colors">Home</a>
      <span>/</span>
      <a href="/blog" class="hover:text-primary transition-colors">Blog</a>
      <span>/</span>
      <span class="text-primary font-bold">Weekly Meeting (Nov 11, 2026)</span>
    </nav>

    <!-- Draft Status Alert Banner -->
    <div class="p-4 sm:p-5 rounded-2xl bg-amber-500/10 border border-amber-500/30 flex items-start gap-3.5 text-on-surface shadow-xs">
      <div class="w-9 h-9 rounded-xl bg-amber-500/20 text-amber-700 dark:text-amber-300 flex items-center justify-center shrink-0 font-bold">
        <span class="material-symbols-outlined text-[20px]">edit_note</span>
      </div>
      <div class="space-y-1">
        <div class="flex items-center gap-2">
          <span class="px-2 py-0.5 rounded-md bg-amber-500 text-white text-[10px] font-black uppercase tracking-wider">
            Draft Post
          </span>
          <span class="text-xs font-bold text-amber-900 dark:text-amber-200">
            Awaiting Final Evening Minutes Sign-Off
          </span>
        </div>
        <p class="text-xs text-on-surface-variant leading-relaxed">
          This post captures the preliminary photo and video coverage of our Wednesday, 11th November 2026 meeting. The full, itemized minutes are currently being compiled and will be incorporated later this evening.
        </p>
      </div>
    </div>

    <!-- Main Header -->
    <header class="space-y-4 border-b border-surface-container pb-8">
      <div class="flex flex-wrap items-center gap-2">
        <span class="px-3 py-1 rounded-full bg-[#FCC30B] text-black text-xs font-black shadow-xs">
          SDG 7: Clean Energy
        </span>
        <span class="px-3 py-1 rounded-full bg-[#BF8B2E] text-white text-xs font-black shadow-xs">
          SDG 12: Sustainability
        </span>
        <span class="px-3 py-1 rounded-full bg-[#4C9F38] text-white text-xs font-black shadow-xs">
          SDG 3: Health & Welfare
        </span>
        <span class="px-3 py-1 rounded-full bg-surface-container text-primary text-xs font-bold">
          Week 6 • 4th Quarter
        </span>
      </div>

      <h1 class="text-2xl sm:text-4xl font-extrabold text-on-surface tracking-tight leading-tight">
        Weekly CDS Meeting: Newcomers Reception, Biodigester Project Progress & Solidarity Baby Visit
      </h1>

      <!-- Metadata Byline -->
      <div class="flex flex-wrap items-center justify-between gap-4 pt-2 text-xs text-on-surface-variant border-t border-surface-container/60">
        <div class="flex flex-wrap items-center gap-4">
          <span class="flex items-center gap-1.5 font-semibold">
            <span class="material-symbols-outlined text-[16px] text-primary">calendar_today</span>
            <span>Wednesday, 11th November, 2026</span>
          </span>
          <span class="flex items-center gap-1.5 font-semibold">
            <span class="material-symbols-outlined text-[16px] text-primary">schedule</span>
            <span>Started 9:00 AM</span>
          </span>
          <span class="flex items-center gap-1.5 font-semibold">
            <span class="material-symbols-outlined text-[16px] text-primary">location_on</span>
            <span>Egor NYSC Secretariat, Benin City</span>
          </span>
        </div>

        <div class="flex items-center gap-2">
          <a
            href="/events"
            class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl bg-surface-container-low text-on-surface text-xs font-bold hover:bg-surface-container border border-surface-container-high transition-all"
          >
            <span class="material-symbols-outlined text-[15px]">event</span>
            <span>Events Gallery</span>
          </a>
          <a
            href="/blog"
            class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl bg-surface-container-low text-on-surface text-xs font-bold hover:bg-surface-container border border-surface-container-high transition-all"
          >
            <span class="material-symbols-outlined text-[15px]">newspaper</span>
            <span>All Stories</span>
          </a>
        </div>
      </div>
    </header>

    <!-- SECTION 1: Featured Main Compilation Video (complilation.mp4) -->
    <section class="bg-surface-container-low p-6 sm:p-8 rounded-3xl border border-surface-container space-y-4 shadow-sm">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-surface-container pb-3">
        <div>
          <span class="inline-flex items-center gap-1.5 text-xs font-bold text-primary uppercase tracking-wider">
            <span class="material-symbols-outlined text-[18px]">movie</span>
            <span>Official Event Summary Video</span>
          </span>
          <h2 class="text-xl sm:text-2xl font-extrabold text-on-surface">
            Meeting Highlights & Outreach Compilation
          </h2>
        </div>
        <span class="px-3 py-1 rounded-full bg-primary/10 text-primary text-xs font-bold self-start sm:self-auto flex items-center gap-1">
          <span class="material-symbols-outlined text-[14px]">videocam</span>
          <span>complilation.mp4</span>
        </span>
      </div>

      <div class="relative aspect-16/9 rounded-2xl overflow-hidden bg-black shadow-elevated border border-surface-container">
        <video
          controls
          playsinline
          preload="metadata"
          poster="/nov11_babyvisit/sdg_01.jpg"
          class="w-full h-full object-contain bg-black"
        >
          <source src="/nov11_babyvisit/complilation.mp4" type="video/mp4" />
          Your browser does not support the video tag.
        </video>
      </div>

      <p class="text-xs sm:text-sm text-on-surface-variant leading-relaxed">
        Comprehensive video compilation capturing the essence of the 11th November 2026 meeting: from the welcome reception of newly deployed corps members at the Egor NYSC Secretariat, to technical project review of the community biodigester, through to the heartwarming moments of our delegation visiting our colleague to celebrate her new baby.
      </p>
    </section>

    <!-- SECTION 2: Sub-Videos from the Baby Visit -->
    <section class="bg-surface-container-lowest p-6 sm:p-8 rounded-3xl border border-surface-container space-y-5">
      <div>
        <span class="text-xs font-bold text-secondary uppercase tracking-wider block">Welfare & Solidarity Clips</span>
        <h3 class="text-lg sm:text-xl font-bold text-on-surface">Moments from the Colleague Baby Visit</h3>
        <p class="text-xs text-on-surface-variant mt-0.5">
          Short video recordings documented during our welfare delegation visit.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <!-- Clip 1 -->
        <div class="space-y-2 bg-surface-container-low p-3.5 rounded-2xl border border-surface-container">
          <div class="relative aspect-9/16 max-h-[360px] mx-auto rounded-xl overflow-hidden bg-black shadow-xs">
            <video
              controls
              playsinline
              preload="metadata"
              poster="/nov11_babyvisit/baby_01.jpg"
              class="w-full h-full object-cover bg-black"
            >
              <source src="/nov11_babyvisit/babyvideo_01.mp4" type="video/mp4" />
              Your browser does not support video.
            </video>
          </div>
          <p class="text-[11px] font-bold text-on-surface text-center line-clamp-1">Arrival & Greetings (Clip 1)</p>
        </div>

        <!-- Clip 2 -->
        <div class="space-y-2 bg-surface-container-low p-3.5 rounded-2xl border border-surface-container">
          <div class="relative aspect-9/16 max-h-[360px] mx-auto rounded-xl overflow-hidden bg-black shadow-xs">
            <video
              controls
              playsinline
              preload="metadata"
              poster="/nov11_babyvisit/baby_03.jpg"
              class="w-full h-full object-cover bg-black"
            >
              <source src="/nov11_babyvisit/babyvideo_02.mp4" type="video/mp4" />
              Your browser does not support video.
            </video>
          </div>
          <p class="text-[11px] font-bold text-on-surface text-center line-clamp-1">Presentation & Smiles (Clip 2)</p>
        </div>

        <!-- Clip 3 -->
        <div class="space-y-2 bg-surface-container-low p-3.5 rounded-2xl border border-surface-container">
          <div class="relative aspect-9/16 max-h-[360px] mx-auto rounded-xl overflow-hidden bg-black shadow-xs">
            <video
              controls
              playsinline
              preload="metadata"
              poster="/nov11_babyvisit/baby_05.jpg"
              class="w-full h-full object-cover bg-black"
            >
              <source src="/nov11_babyvisit/babyvideo_03.mp4" type="video/mp4" />
              Your browser does not support video.
            </video>
          </div>
          <p class="text-[11px] font-bold text-on-surface text-center line-clamp-1">Goodwill & Prayers (Clip 3)</p>
        </div>
      </div>
    </section>

    <!-- SECTION 3: Key Meeting Pillars & Executive Narrative -->
    <div class="space-y-8 text-on-surface text-sm sm:text-base leading-relaxed">
      
      <!-- Key Summary Block -->
      <section class="bg-surface-container-low p-6 sm:p-8 rounded-3xl border border-surface-container space-y-3">
        <h2 class="text-base sm:text-lg font-extrabold text-[#004b24] uppercase tracking-wide flex items-center gap-2">
          <span class="material-symbols-outlined text-[20px]">groups</span>
          <span>Meeting Summary & Executive Focus</span>
        </h2>
        <p class="text-justify text-on-surface-variant leading-relaxed">
          The weekly CDS meeting convened promptly at 9:00 AM on Wednesday, 11th November 2026 at the Egor NYSC Secretariat. Today's gathering was particularly memorable as it blended core SDG programmatic work with profound community bonding: the induction of freshly deployed corps members into our thematic working groups, a thorough progress review of our flagship community School Biodigester project, and an inspiring welfare visit to celebrate our fellow corps member who recently delivered a healthy baby.
        </p>
      </section>

      <!-- Three Core Milestones Grid -->
      <section class="space-y-4">
        <h2 class="text-xl sm:text-2xl font-bold text-on-surface">
          Three Key Agendas of the Day
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-2">
          
          <!-- Agenda 1: Newcomers -->
          <div class="p-5 rounded-2xl bg-surface-container-lowest border border-surface-container shadow-subtle space-y-2.5">
            <div class="w-8 h-8 rounded-xl bg-primary text-on-primary flex items-center justify-center font-bold text-xs">
              1
            </div>
            <h3 class="font-bold text-on-surface text-sm sm:text-base">
              Newcomers Reception & Orientation
            </h3>
            <p class="text-xs text-on-surface-variant leading-relaxed text-justify">
              Warm reception of newly deployed corps members posted to Egor LGA. The executive council provided an introductory briefing on the UN 17 SDGs, CDS code of conduct, weekly attendance protocols, and active committee placements.
            </p>
            <div class="pt-1 flex items-center gap-1 text-[11px] font-bold text-primary">
              <span>{newcomerPhotos.length} Documented Photos</span>
            </div>
          </div>

          <!-- Agenda 2: Biodigester -->
          <div class="p-5 rounded-2xl bg-surface-container-lowest border border-surface-container shadow-subtle space-y-2.5">
            <div class="w-8 h-8 rounded-xl bg-[#FCC30B] text-black flex items-center justify-center font-bold text-xs">
              2
            </div>
            <h3 class="font-bold text-on-surface text-sm sm:text-base">
              School Biodigester Project Review (SDG 7 & 12)
            </h3>
            <p class="text-xs text-on-surface-variant leading-relaxed text-justify">
              In-depth assessment of the proposed pilot biodigester system. Evaluated organic waste sourcing from school cafeterias, anaerobic conversion mechanics, safety plumbing, and production of clean cooking gas and organic bio-fertilizer.
            </p>
            <div class="pt-1 flex items-center gap-1 text-[11px] font-bold text-[#FCC30B]">
              <span>{biodigesterPhotos.length} Documented Photos</span>
            </div>
          </div>

          <!-- Agenda 3: Baby Visit -->
          <div class="p-5 rounded-2xl bg-surface-container-lowest border border-surface-container shadow-subtle space-y-2.5">
            <div class="w-8 h-8 rounded-xl bg-[#4C9F38] text-white flex items-center justify-center font-bold text-xs">
              3
            </div>
            <h3 class="font-bold text-on-surface text-sm sm:text-base">
              Colleague Welfare & Baby Visit (SDG 3)
            </h3>
            <p class="text-xs text-on-surface-variant leading-relaxed text-justify">
              Living out the spirit of NYSC unity, a delegation of corps members visited our serving colleague who recently gave birth. We presented maternal care packages, baby gifts, and collective prayers from the entire Egor SDG group.
            </p>
            <div class="pt-1 flex items-center gap-1 text-[11px] font-bold text-[#4C9F38]">
              <span>{babyPhotos.length} Photos + 3 Videos</span>
            </div>
          </div>

        </div>
      </section>

      <!-- SECTION 4: Structured Draft Minutes Placeholder -->
      <section class="bg-surface-container-low p-6 sm:p-8 rounded-3xl border border-dashed border-primary/40 space-y-4">
        <div class="flex items-center justify-between border-b border-surface-container pb-3">
          <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-primary text-[22px]">description</span>
            <h3 class="text-base sm:text-lg font-bold text-on-surface">
              Meeting Minutes (Official Sign-Off Pending)
            </h3>
          </div>
          <span class="text-xs font-semibold text-on-surface-variant bg-surface-container px-3 py-1 rounded-full">
            Detailed text arriving this evening
          </span>
        </div>

        <p class="text-xs sm:text-sm text-on-surface-variant leading-relaxed">
          The CDS Secretariat is currently transcribing the comprehensive meeting minutes. The final signed document covering roll call, executive announcements, resolutions on the biodigester project, and upcoming outreach schedules will be published in this section once approved.
        </p>

        <!-- Placeholder Sections -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2 text-xs">
          <div class="p-3.5 rounded-xl bg-surface-container-lowest border border-surface-container space-y-1">
            <span class="font-bold text-primary uppercase text-[10px] tracking-wider block">1. Attendance & Roll Call</span>
            <p class="text-on-surface-variant text-[11px]">Serving corps members present, newly joined members registered, and excuses recorded.</p>
          </div>

          <div class="p-3.5 rounded-xl bg-surface-container-lowest border border-surface-container space-y-1">
            <span class="font-bold text-primary uppercase text-[10px] tracking-wider block">2. Executive Updates</span>
            <p class="text-on-surface-variant text-[11px]">Remarks by President Augusta, review of committee tasks, and 4th Quarter timeline.</p>
          </div>

          <div class="p-3.5 rounded-xl bg-surface-container-lowest border border-surface-container space-y-1">
            <span class="font-bold text-primary uppercase text-[10px] tracking-wider block">3. Biodigester Resolutions</span>
            <p class="text-on-surface-variant text-[11px]">Approval of procurement budget, site verification visit, and school permissions.</p>
          </div>

          <div class="p-3.5 rounded-xl bg-surface-container-lowest border border-surface-container space-y-1">
            <span class="font-bold text-primary uppercase text-[10px] tracking-wider block">4. Welfare & Adjournment</span>
            <p class="text-on-surface-variant text-[11px]">Welfare contribution wrap-up, baby visit delegation logistics, and closing prayer.</p>
          </div>
        </div>
      </section>

      <!-- SECTION 5: Categorized Photographic Exhibition (All 37 Photos) -->
      <section class="space-y-6 pt-4 border-t border-surface-container">
        
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
          <div>
            <span class="text-xs font-bold text-primary uppercase tracking-wider block">
              Complete Visual Documentation (37 Photographic Plates)
            </span>
            <h2 class="text-xl sm:text-2xl font-bold text-on-surface">
              Photo Exhibition: Meeting & Field Activities
            </h2>
          </div>
          <span class="text-xs text-on-surface-variant font-medium">
            Wednesday, 11th November 2026
          </span>
        </div>

        <!-- Subsection A: Welcoming Newcomers -->
        {newcomerPhotos.length > 0 && (
          <div class="space-y-3 bg-surface-container-lowest p-5 sm:p-6 rounded-3xl border border-surface-container">
            <div class="flex items-center justify-between border-b border-surface-container pb-2.5">
              <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-primary"></span>
                <h3 class="text-sm sm:text-base font-bold text-on-surface">
                  Part 1: Welcoming Newly Deployed Corps Members ({newcomerPhotos.length} Plates)
                </h3>
              </div>
              <span class="text-xs text-on-surface-variant">Orientation & Induction</span>
            </div>
            <BlogPhotoGrid client:load photos={newcomerPhotos} />
          </div>
        )}

        <!-- Subsection B: Biodigester Project -->
        {biodigesterPhotos.length > 0 && (
          <div class="space-y-3 bg-surface-container-lowest p-5 sm:p-6 rounded-3xl border border-surface-container">
            <div class="flex items-center justify-between border-b border-surface-container pb-2.5">
              <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-[#FCC30B]"></span>
                <h3 class="text-sm sm:text-base font-bold text-on-surface">
                  Part 2: School Biodigester Project Update ({biodigesterPhotos.length} Plates)
                </h3>
              </div>
              <span class="text-xs text-on-surface-variant">SDG 7 & 12 Engineering Review</span>
            </div>
            <BlogPhotoGrid client:load photos={biodigesterPhotos} />
          </div>
        )}

        <!-- Subsection C: Baby Visit -->
        {babyPhotos.length > 0 && (
          <div class="space-y-3 bg-surface-container-lowest p-5 sm:p-6 rounded-3xl border border-surface-container">
            <div class="flex items-center justify-between border-b border-surface-container pb-2.5">
              <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-[#4C9F38]"></span>
                <h3 class="text-sm sm:text-base font-bold text-on-surface">
                  Part 3: Colleague Welfare & Baby Visit ({babyPhotos.length} Plates)
                </h3>
              </div>
              <span class="text-xs text-on-surface-variant">Celebration & NYSC Solidarity</span>
            </div>
            <BlogPhotoGrid client:load photos={babyPhotos} />
          </div>
        )}

        <!-- Subsection D: General CDS Cadre -->
        {sdgPhotos.length > 0 && (
          <div class="space-y-3 bg-surface-container-lowest p-5 sm:p-6 rounded-3xl border border-surface-container">
            <div class="flex items-center justify-between border-b border-surface-container pb-2.5">
              <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-secondary"></span>
                <h3 class="text-sm sm:text-base font-bold text-on-surface">
                  Part 4: General CDS Assembly & Executive Session ({sdgPhotos.length} Plates)
                </h3>
              </div>
              <span class="text-xs text-on-surface-variant">Egor NYSC Secretariat</span>
            </div>
            <BlogPhotoGrid client:load photos={sdgPhotos} />
          </div>
        )}

      </section>

    </div>

    <!-- Navigation Footer -->
    <div class="pt-6 border-t border-surface-container flex flex-col sm:flex-row items-center justify-between gap-4">
      <a
        href="/blog/ogida-market-quality-education"
        class="inline-flex items-center gap-2 text-xs sm:text-sm font-bold text-on-surface-variant hover:text-primary transition-colors"
      >
        <span class="material-symbols-outlined text-[18px]">arrow_back</span>
        <span>Previous: Ogida Market Quality Education (SDG 4)</span>
      </a>

      <a
        href="/blog"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-primary hover:bg-primary-container text-on-primary text-xs font-bold shadow-sm transition-all"
      >
        <span>Back to All Stories</span>
        <span class="material-symbols-outlined text-[16px]">menu_book</span>
      </a>
    </div>

  </article>
</Layout>
