---
import Layout from '../../layouts/Layout.astro';
import { IdeasExplorer } from '../../components/ideas/IdeasExplorer';
import { fetchIdeas } from '../../lib/supabase';

const ideas = await fetchIdeas();
---

<Layout 
  title="Community Ideas Hub • NYSC Egor SDG CDS"
  description="A democratic civic space for corps members serving in Egor Local Government Area to anonymously pitch community solutions and vote on peer ideas."
  image="/ogida/1.jpg"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12 space-y-8">
    
    <!-- Clean Header Banner -->
    <div class="bg-surface-container-low p-6 sm:p-10 rounded-3xl border border-outline-variant/30 space-y-3 shadow-subtle">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-surface-container text-primary text-xs font-bold uppercase tracking-wider">
        <span class="material-symbols-outlined text-[16px]">forum</span>
        <span>Egor Grassroots Ideation • NYSC SDG CDS</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-on-surface tracking-tight leading-tight">
        Community Ideas for <span class="text-primary">Egor LGA</span>
      </h1>
      <p class="text-sm sm:text-base text-on-surface-variant max-w-2xl leading-relaxed">
        A democratic space for corps members serving across Egor Local Government Area to anonymously propose community interventions, upvote practical solutions, and shape projects approved at the Egor NYSC Secretariat.
      </p>
    </div>

    <!-- Youth Viral Engagement Strip -->
    <div class="bg-surface-container-lowest p-4 sm:p-5 rounded-2xl border border-surface-container flex flex-col sm:flex-row items-center justify-between gap-4 shadow-subtle">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-[#25D366]/15 text-[#25D366] flex items-center justify-center font-bold shrink-0">
          <span class="material-symbols-outlined text-[20px]">share</span>
        </div>
        <div>
          <h4 class="text-xs sm:text-sm font-bold text-on-surface">Share Ideas to Your CDS WhatsApp Group</h4>
          <p class="text-[11px] sm:text-xs text-on-surface-variant">Click the 1-click WhatsApp button on any idea card to mobilize fellow corps members to vote.</p>
        </div>
      </div>
      <a
        href="#drop"
        class="inline-flex items-center gap-1.5 px-4 py-2 bg-primary text-on-primary rounded-xl text-xs font-bold hover:bg-primary-container shrink-0 transition-all shadow-subtle"
      >
        <span class="material-symbols-outlined text-[16px]">add_circle</span>
        <span>Pitch a New Idea</span>
      </a>
    </div>

    <!-- Interactive Explorer -->
    <IdeasExplorer client:load initialIdeas={ideas} />

  </div>
</Layout>
