---
import Layout from '../../layouts/Layout.astro';
import { fetchProjects } from '../../lib/supabase';
import { SDG_METADATA } from '../../types/database';

const projects = await fetchProjects();
const totalBudget = projects.reduce((acc, p) => acc + (Number(p.estimated_cost) || 0), 0);

const statusLabels: Record<string, { label: string; bg: string; text: string }> = {
  concept: { label: 'Concept Stage', bg: 'bg-surface-container', text: 'text-on-surface-variant' },
  planning: { label: 'In Active Planning', bg: 'bg-secondary-fixed/50', text: 'text-secondary' },
  fundraising: { label: 'Fundraising & Seeking Sponsors', bg: 'bg-error-container', text: 'text-on-error-container' },
  in_progress: { label: 'Execution In Progress', bg: 'bg-primary-fixed', text: 'text-on-primary-fixed' },
  completed: { label: 'Successfully Completed', bg: 'bg-tertiary-fixed', text: 'text-on-tertiary-fixed' },
};
---

<Layout
  title="Planned Projects & Community Budget Tracker"
  description="Transparent overview of planned Edo State NYSC SDG community projects with itemized budgets, UN SDG mapping, and target partners."
>
  <div class="flex flex-col w-full pb-space-3xl">
    
    <!-- Operational Tracker Header Block -->
    <div class="w-full bg-surface-container-low px-margin-mobile md:px-margin-desktop py-space-2xl border-b border-surface-container-high">
      <div class="max-w-7xl mx-auto flex flex-col gap-space-lg">
        
        <!-- Metadata Tag & Live Indicator -->
        <div class="flex flex-wrap items-center justify-between gap-space-sm">
          <div class="flex items-center gap-space-xs">
            <span class="inline-flex items-center gap-1.5 px-space-sm py-0.5 rounded-full bg-primary/10 text-primary font-label-sm text-label-sm tracking-wide">
              <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
              ACTIVE FINANCIAL YEAR 2026
            </span>
            <span class="text-outline text-label-sm font-label-sm font-semibold">|</span>
            <span class="font-label-sm text-label-sm text-on-surface-variant font-medium">EDO STATE CDS TRACKING NO. ED/CDS/SDG/24-B</span>
          </div>
          <div class="flex items-center gap-space-xs">
            <span class="material-symbols-outlined text-primary text-[18px]">verified_user</span>
            <span class="font-label-sm text-label-sm text-primary font-bold">State Coordinator Certified Registry</span>
          </div>
        </div>

        <!-- Title & Civic Manifesto -->
        <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-space-md">
          <div class="max-w-3xl space-y-space-xs">
            <h1 class="font-display text-display text-on-surface tracking-tight leading-tight">
              Planned Projects & <span class="text-primary">Community Budget</span> Tracker
            </h1>
            <p class="font-body-lg text-body-lg text-on-surface-variant">
              Transparent accountability of all upcoming NYSC SDG CDS initiatives across Egor Local Government Area. Itemized budgets, partner outreach, and community impact goals.
            </p>
          </div>
          <div class="flex items-center gap-space-sm shrink-0">
            <a
              href="/ideas#drop"
              class="inline-flex items-center gap-2 px-5 py-2.5 bg-primary text-on-primary font-bold text-sm rounded-xl shadow-sm hover:bg-primary-container transition-all active:scale-95"
            >
              <span class="material-symbols-outlined text-[18px]">lightbulb</span>
              <span>Submit an Idea</span>
            </a>
          </div>
        </div>

        <!-- Financial Metrics Ribbon Bento -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-space-md pt-space-md">
          <!-- Metric 1: Total Capital Target -->
          <div class="bg-surface-container-lowest p-space-lg rounded-xl shadow-sm border border-surface-container-high flex flex-col justify-between">
            <div class="flex items-center justify-between text-on-surface-variant">
              <span class="font-label-md text-label-md font-semibold tracking-wider uppercase">Planned Capital Target</span>
              <span class="p-1.5 rounded-lg bg-surface-container text-primary">
                <span class="material-symbols-outlined text-[20px]">payments</span>
              </span>
            </div>
            <div class="mt-space-md">
              <div class="font-stat-counter text-stat-counter text-on-surface font-extrabold leading-none">
                ₦{totalBudget.toLocaleString()}
              </div>
              <p class="font-body-sm text-body-sm text-on-surface-variant mt-1">
                Aggregated requirement ({projects.length} planned initiatives)
              </p>
            </div>
          </div>

          <!-- Metric 2: Published Projects -->
          <div class="bg-surface-container-lowest p-space-lg rounded-xl shadow-sm border border-surface-container-high flex flex-col justify-between">
            <div class="flex items-center justify-between text-on-surface-variant">
              <span class="font-label-md text-label-md font-semibold tracking-wider uppercase">Active Initiatives</span>
              <span class="p-1.5 rounded-lg bg-secondary-container/40 text-on-secondary-container">
                <span class="material-symbols-outlined text-[20px]">assignment</span>
              </span>
            </div>
            <div class="mt-space-md">
              <div class="font-stat-counter text-stat-counter text-secondary font-extrabold leading-none">
                {projects.length}
              </div>
              <p class="font-body-sm text-body-sm text-on-surface-variant mt-1">
                Under committee review
              </p>
            </div>
          </div>

          <!-- Metric 3: Target LGA -->
          <div class="bg-surface-container-lowest p-space-lg rounded-xl shadow-sm border border-surface-container-high flex flex-col justify-between">
            <div class="flex items-center justify-between text-on-surface-variant">
              <span class="font-label-md text-label-md font-semibold tracking-wider uppercase">Focus Jurisdiction</span>
              <span class="p-1.5 rounded-lg bg-surface-container text-tertiary">
                <span class="material-symbols-outlined text-[20px]">location_city</span>
              </span>
            </div>
            <div class="mt-space-md">
              <div class="font-stat-counter text-stat-counter text-on-surface font-extrabold leading-none">
                Egor LGA
              </div>
              <p class="font-body-sm text-body-sm text-on-surface-variant mt-1">
                Egor NYSC Secretariat
              </p>
            </div>
          </div>

          <!-- Metric 4: Direct Transparency -->
          <div class="bg-surface-container-lowest p-space-lg rounded-xl shadow-sm border border-surface-container-high flex flex-col justify-between">
            <div class="flex items-center justify-between text-on-surface-variant">
              <span class="font-label-md text-label-md font-semibold tracking-wider uppercase">Accountability</span>
              <span class="p-1.5 rounded-lg bg-surface-container text-primary">
                <span class="material-symbols-outlined text-[20px]">verified</span>
              </span>
            </div>
            <div class="mt-space-md">
              <div class="font-stat-counter text-stat-counter text-primary font-extrabold leading-none">
                100%
              </div>
              <p class="font-body-sm text-body-sm text-on-surface-variant mt-1">
                Open itemized budgets & attachments
              </p>
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- Main Project Stream -->
    <div class="w-full max-w-7xl mx-auto px-margin-mobile md:px-margin-desktop py-space-xl space-y-space-lg">
      
      {projects.length === 0 ? (
        <div class="bg-surface-container-lowest rounded-2xl border border-dashed border-outline-variant p-space-2xl text-center space-y-space-sm max-w-2xl mx-auto shadow-sm">
          <div class="w-16 h-16 rounded-2xl bg-surface-container text-primary mx-auto flex items-center justify-center text-3xl font-bold">
            <span class="material-symbols-outlined text-[36px]">assignment_turned_in</span>
          </div>
          <h2 class="font-headline-md text-headline-md text-on-surface font-bold">
            No Published Projects Yet
          </h2>
          <p class="font-body-md text-body-md text-on-surface-variant max-w-md mx-auto">
            Our NYSC SDG CDS group is actively crowdsourcing anonymous community proposals from corps members across Egor Local Government Area. As soon as an initiative is approved and budgeted, full itemized financials will be published here.
          </p>
          <div class="pt-space-sm">
            <a
              href="/ideas#drop"
              class="inline-flex items-center gap-space-xs px-space-xl py-space-sm bg-primary text-on-primary font-label-lg text-label-lg rounded-xl shadow-sm hover:bg-primary-container transition-all"
            >
              <span>+ Submit an Idea in the Ideas Hub</span>
            </a>
          </div>
        </div>
      ) : (
        <div class="space-y-space-lg">
          {projects.map((project) => {
            const status = statusLabels[project.status] || statusLabels.planning;

            return (
              <div class="bg-surface-container-lowest rounded-2xl border border-surface-container-high overflow-hidden shadow-sm hover:shadow-md transition-all">
                <div class="grid grid-cols-1 lg:grid-cols-12">
                  
                  {project.cover_image && (
                    <div class="lg:col-span-4 relative aspect-16/10 lg:aspect-auto">
                      <img
                        src={project.cover_image}
                        alt={project.title}
                        class="w-full h-full object-cover"
                      />
                      <div class="absolute top-4 left-4">
                        <span class={`px-3 py-1 rounded-full font-label-sm text-label-sm font-bold shadow-xs ${status.bg} ${status.text}`}>
                          {status.label}
                        </span>
                      </div>
                    </div>
                  )}

                  <div class={project.cover_image ? "lg:col-span-8 p-space-xl space-y-space-md" : "lg:col-span-12 p-space-xl space-y-space-md"}>
                    <div class="flex flex-wrap items-center justify-between gap-3">
                      <div class="flex items-center gap-2 font-label-sm text-label-sm text-on-surface-variant">
                        <span>📍 {project.target_location}</span>
                        {project.target_date && <span>• Target: {project.target_date}</span>}
                      </div>
                      {!project.cover_image && (
                        <span class={`px-3 py-1 rounded-full font-label-sm text-label-sm font-bold ${status.bg} ${status.text}`}>
                          {status.label}
                        </span>
                      )}
                    </div>

                    <h2 class="font-headline-md text-headline-md text-on-surface font-bold leading-tight">
                      {project.title}
                    </h2>
                    <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed">
                      {project.description}
                    </p>

                    <!-- SDG Tags -->
                    {project.sdg_goals && project.sdg_goals.length > 0 && (
                      <div class="flex flex-wrap gap-1.5">
                        {project.sdg_goals.map((g) => {
                          const meta = SDG_METADATA[g];
                          if (!meta) return null;
                          return (
                            <span
                              key={g}
                              style={{ backgroundColor: meta.color }}
                              class="px-2.5 py-0.5 rounded-full text-white text-[11px] font-bold shadow-xs"
                            >
                              SDG {g}: {meta.name}
                            </span>
                          );
                        })}
                      </div>
                    )}

                    <!-- Budget & Stakeholders -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-space-md pt-space-xs">
                      <div class="bg-surface-container-low p-space-md rounded-xl">
                        <span class="font-label-sm text-label-sm text-on-surface-variant uppercase font-semibold">Total Estimated Budget</span>
                        <div class="font-headline-sm text-headline-sm text-primary font-extrabold mt-0.5">
                          ₦{Number(project.estimated_cost).toLocaleString()}
                        </div>
                      </div>
                      <div class="bg-surface-container-low p-space-md rounded-xl">
                        <span class="font-label-sm text-label-sm text-on-surface-variant uppercase font-semibold">Stakeholders to Engage</span>
                        <p class="font-body-sm text-body-sm text-on-surface font-medium mt-0.5">
                          {project.stakeholders_to_reach.join(', ')}
                        </p>
                      </div>
                    </div>

                    <!-- Itemized Budget Table -->
                    {project.budget_breakdown && project.budget_breakdown.length > 0 && (
                      <div class="space-y-space-xs pt-space-xs">
                        <h4 class="font-label-md text-label-md text-on-surface font-bold uppercase tracking-wider">
                          Itemized Budget Breakdown
                        </h4>
                        <div class="bg-surface-container-low rounded-xl overflow-hidden border border-surface-container-high divide-y divide-surface-container-high">
                          {project.budget_breakdown.map((item) => (
                            <div class="p-3 flex items-center justify-between text-xs">
                              <span class="text-on-surface font-medium">{item.item}</span>
                              <span class="text-primary font-bold">₦{Number(item.cost).toLocaleString()}</span>
                            </div>
                          ))}
                        </div>
                      </div>
                    )}
                  </div>

                </div>
              </div>
            );
          })}
        </div>
      )}

    </div>
  </div>
</Layout>
