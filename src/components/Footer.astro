---
import { SDG_METADATA } from '../types/database';

const sdgGoals = Object.values(SDG_METADATA);
---

<footer class="bg-nysc-green-deep text-white border-t-4 border-nysc-gold">
  <!-- SDG 17 Color Ribbon -->
  <div class="grid grid-cols-17 h-2 w-full">
    {sdgGoals.map((sdg) => (
      <div style={`background-color: ${sdg.color};`} title={`SDG ${sdg.number}: ${sdg.name}`} class="h-full" />
    ))}
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10">
      
      <!-- Col 1: Brand & NYSC Crest info -->
      <div class="md:col-span-2 space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-nysc-gold text-nysc-green-deep font-black flex items-center justify-center text-lg shadow-sm">
            NYSC
          </div>
          <div>
            <h3 class="text-lg font-bold tracking-tight text-white">Edo State SDG CDS Group</h3>
            <p class="text-xs text-nysc-gold font-medium uppercase tracking-wider">Service and Humility · Agenda 2030</p>
          </div>
        </div>
        <p class="text-sm text-slate-300 max-w-md leading-relaxed">
          Uniting corps members across Edo State to advance the 17 United Nations Sustainable Development Goals. Empowering communities through grassroots initiatives, anonymous youth ideation, and strategic partnerships.
        </p>
        <div class="pt-2 flex flex-wrap gap-2 text-xs text-slate-300">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-md bg-white/10 border border-white/10">
            📍 Benin City, Edo State
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-md bg-white/10 border border-white/10">
            🎯 Priority: Menstrual Hygiene & Sanitation
          </span>
        </div>
      </div>

      <!-- Col 2: Navigation Links -->
      <div class="space-y-3">
        <h4 class="text-sm font-bold uppercase tracking-wider text-nysc-gold">Platform Sections</h4>
        <ul class="space-y-2 text-sm text-slate-300">
          <li><a href="/" class="hover:text-white transition-colors">Home & Overview</a></li>
          <li><a href="/projects" class="hover:text-white transition-colors">Project Planner & Budgets</a></li>
          <li><a href="/gallery" class="hover:text-white transition-colors">Event Photo Gallery</a></li>
          <li><a href="/ideas" class="hover:text-white transition-colors">Anonymous Ideas Hub</a></li>
          <li><a href="/portal/funding" class="hover:text-white transition-colors">Benin NGO Directory</a></li>
          <li><a href="/portal/pitch-kit" class="hover:text-white transition-colors">Sponsorship Pitch Kit</a></li>
        </ul>
      </div>

      <!-- Col 3: First Need Initiatives -->
      <div class="space-y-3">
        <h4 class="text-sm font-bold uppercase tracking-wider text-nysc-gold">Immediate Outreaches</h4>
        <div class="space-y-2 text-xs text-slate-300">
          <div class="p-3 rounded-lg bg-white/5 border border-white/10">
            <span class="font-bold text-white block">🩸 Sanitary Pad Bank</span>
            <p class="text-slate-400 mt-1">Free sanitary pad drives in Benin City public secondary schools.</p>
          </div>
          <div class="p-3 rounded-lg bg-white/5 border border-white/10">
            <span class="font-bold text-white block">🧹 Clean Edo Campaign</span>
            <p class="text-slate-400 mt-1">Drainage clearance and market sanitation in partnership with ESWMB.</p>
          </div>
        </div>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 pt-6 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-400 gap-4">
      <p>© {new Date().getFullYear()} Edo State NYSC Sustainable Development Goals (SDG) CDS Group. All rights reserved.</p>
      <div class="flex items-center gap-4">
        <a href="/admin" class="text-slate-400 hover:text-nysc-gold transition-colors">Admin Portal</a>
        <span>·</span>
        <a href="https://sdgs.un.org" target="_blank" rel="noopener noreferrer" class="text-slate-400 hover:text-white transition-colors">UN SDG Official</a>
      </div>
    </div>
  </div>
</footer>
