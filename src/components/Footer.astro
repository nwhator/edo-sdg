<footer class="w-full bg-on-primary-fixed text-surface-container-lowest mt-space-3xl border-t border-primary-container">
  <div class="max-w-7xl mx-auto px-margin-mobile md:px-margin-desktop py-space-3xl">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-space-xl">
      
      <!-- Brand & Zonal Headquarters -->
      <div class="space-y-space-md">
        <div class="flex items-center gap-space-sm">
          <div class="w-9 h-9 rounded-lg bg-primary-container flex items-center justify-center text-on-primary font-bold shadow-sm ring-1 ring-secondary-container">
            <span class="font-display text-sm tracking-tighter">SDG</span>
          </div>
          <span class="font-title-md text-title-md font-bold text-surface-container-lowest">NYSC Edo SDG CDS</span>
        </div>
        <p class="font-body-sm text-body-sm text-outline-variant leading-relaxed">
          Empowering Benin City communities through youth-led sustainable innovations, civic advocacy, and public education aligned with the United Nations 2030 Agenda.
        </p>
        <div class="pt-space-xs font-label-sm text-label-sm text-secondary-fixed">
          <p class="font-bold uppercase tracking-wider">Zonal Headquarters</p>
          <p class="text-surface-variant font-normal">Oba Ovonramwen Square & Egor Secretariat, Benin City, Edo State.</p>
        </div>
      </div>

      <!-- UN 17 Global Goals -->
      <div class="space-y-space-md">
        <h4 class="font-title-md text-title-md font-bold text-secondary-fixed tracking-wide">
          UN 17 Global Goals
        </h4>
        <ul class="space-y-space-xs font-body-sm text-body-sm text-outline-variant">
          <li class="hover:text-surface-container-lowest transition-colors"><a href="/#sdg-grid">Goal 3: Good Health & Well-being</a></li>
          <li class="hover:text-surface-container-lowest transition-colors"><a href="/#sdg-grid">Goal 4: Quality Education</a></li>
          <li class="hover:text-surface-container-lowest transition-colors"><a href="/#sdg-grid">Goal 5: Gender Equality</a></li>
          <li class="hover:text-surface-container-lowest transition-colors"><a href="/#sdg-grid">Goal 6: Clean Water & Sanitation</a></li>
          <li class="hover:text-surface-container-lowest transition-colors"><a href="/#sdg-grid">Goal 11: Sustainable Cities & Communities</a></li>
          <li class="hover:text-surface-container-lowest transition-colors"><a href="/#sdg-grid">Goal 13: Climate Action & Urban Greenery</a></li>
        </ul>
      </div>

      <!-- Benin City Civil Partners -->
      <div class="space-y-space-md">
        <h4 class="font-title-md text-title-md font-bold text-secondary-fixed tracking-wide">
          Benin City Civil Alliances
        </h4>
        <ul class="space-y-space-xs font-body-sm text-body-sm text-outline-variant">
          <li>Girls' Power Initiative (GPI) Nigeria</li>
          <li>Edo State Waste Management Board (ESWMB)</li>
          <li>Edo State SDGs Coordination Office</li>
          <li>Rotary Club of Benin (District 9141)</li>
          <li>Africa Network for Environment & Economic Justice</li>
        </ul>
      </div>

      <!-- CDS Administrative Info -->
      <div class="space-y-space-md">
        <h4 class="font-title-md text-title-md font-bold text-secondary-fixed tracking-wide">
          CDS Administrative Info
        </h4>
        <div class="bg-on-primary-fixed-variant p-space-md rounded-xl space-y-space-xs">
          <p class="font-label-sm text-label-sm text-primary-fixed font-bold uppercase tracking-wider">
            Plenary Status: Active CDS
          </p>
          <p class="font-body-sm text-body-sm text-surface-variant">
            Regular CDS Plenary: Thursdays @ 9:00 AM, Imaguero College / Oredo LGA Grounds.
          </p>
          <div class="pt-space-xs">
            <a class="font-label-sm text-label-sm text-secondary-container hover:underline font-bold flex items-center gap-1" href="/admin">
              <span>Executive Portal Access</span>
              <span class="material-symbols-outlined text-[15px]">lock</span>
            </a>
          </div>
        </div>
      </div>

    </div>

    <!-- Bottom Strip -->
    <div class="mt-space-2xl pt-space-lg border-t border-tertiary-container flex flex-col md:flex-row items-center justify-between gap-space-md font-body-sm text-body-sm text-outline-variant">
      <p class="text-center md:text-left text-xs">
        © 2026 National Youth Service Corps (NYSC) Edo State SDGs CDS Group. Operating under the official mandate of the Federal Republic of Nigeria.
      </p>
      <div class="flex items-center gap-space-lg text-xs">
        <a class="hover:text-surface-container-lowest transition-colors" href="/projects">Projects</a>
        <a class="hover:text-surface-container-lowest transition-colors" href="/ideas">Ideas Hub</a>
        <a class="hover:text-surface-container-lowest transition-colors" href="/gallery">Gallery</a>
        <a class="hover:text-surface-container-lowest transition-colors" href="/admin">SDG Portal 🔒</a>
