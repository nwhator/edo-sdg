---
---

<footer class="w-full bg-on-surface text-surface mt-16 border-t border-surface-container">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      
      <!-- Brand & Zonal Headquarters -->
      <div class="space-y-3">
        <div class="flex items-center gap-2.5">
          <div class="w-9 h-9 rounded-xl bg-primary flex items-center justify-center text-white font-extrabold text-sm shadow-sm ring-1 ring-secondary-container">
            SDG
          </div>
          <span class="text-base font-bold text-white">NYSC Egor SDG CDS</span>
        </div>
        <p class="text-xs text-outline-variant leading-relaxed">
          Empowering Egor Local Government communities through youth-led sustainable innovations, civic advocacy, and community education aligned with the UN 2030 Agenda.
        </p>
        <div class="pt-1 text-xs text-secondary-fixed">
          <p class="font-bold uppercase tracking-wider">Secretariat Hub</p>
          <p class="text-surface-container font-normal">Egor NYSC Secretariat, Benin City, Edo State.</p>
        </div>
      </div>

      <!-- UN 17 Global Goals -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold text-secondary-fixed uppercase tracking-wider">
          UN 17 Global Goals
        </h4>
        <ul class="space-y-1.5 text-xs text-outline-variant">
          <li class="hover:text-white transition-colors"><a href="/#sdg-grid">Goal 3: Good Health & Well-being</a></li>
          <li class="hover:text-white transition-colors"><a href="/#sdg-grid">Goal 4: Quality Education</a></li>
          <li class="hover:text-white transition-colors"><a href="/#sdg-grid">Goal 5: Gender Equality</a></li>
          <li class="hover:text-white transition-colors"><a href="/#sdg-grid">Goal 6: Clean Water & Sanitation</a></li>
          <li class="hover:text-white transition-colors"><a href="/#sdg-grid">Goal 11: Sustainable Communities</a></li>
          <li class="hover:text-white transition-colors"><a href="/#sdg-grid">Goal 13: Climate Action</a></li>
        </ul>
      </div>

      <!-- Community Partners -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold text-secondary-fixed uppercase tracking-wider">
          Community Partners
        </h4>
        <ul class="space-y-1.5 text-xs text-outline-variant">
          <li>Girls' Power Initiative (GPI) Nigeria</li>
          <li>Edo State Waste Management Board (ESWMB)</li>
          <li>Edo State SDGs Coordination Office</li>
          <li>Rotary Club of Benin (District 9141)</li>
          <li>Local Egor Secondary Schools & Health Centers</li>
        </ul>
      </div>

      <!-- CDS Administrative Info -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold text-secondary-fixed uppercase tracking-wider">
          Meeting & Assembly
        </h4>
        <div class="bg-white/5 border border-white/10 p-3.5 rounded-xl space-y-1.5">
          <p class="text-[11px] font-bold text-primary-fixed uppercase tracking-wider">
            Plenary Schedule
          </p>
          <p class="text-xs text-surface-container">
            Every Wednesday @ 9:00 AM<br />
            <span class="text-secondary-fixed font-semibold">Egor NYSC Secretariat</span>
          </p>
          <div class="pt-1">
            <a class="text-xs text-secondary-container hover:underline font-bold flex items-center gap-1" href="/admin">
              <span>Admin Portal Login</span>
              <span class="material-symbols-outlined text-[14px]">lock</span>
            </a>
          </div>
        </div>
      </div>

    </div>

    <!-- Bottom Strip -->
    <div class="mt-12 pt-6 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-outline-variant">
      <p class="text-center sm:text-left">
        © 2026 NYSC Egor SDG Community Development Service (CDS) Group. Federal Republic of Nigeria.
      </p>
      <div class="flex items-center gap-4">
        <a class="hover:text-white transition-colors" href="/projects">Projects</a>
        <a class="hover:text-white transition-colors" href="/ideas">Ideas Hub</a>
        <a class="hover:text-white transition-colors" href="/gallery">Gallery</a>
        <a class="hover:text-white transition-colors" href="/admin">Admin 🔒</a>
      </div>
    </div>
  </div>
</footer>
