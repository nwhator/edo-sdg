---
import SdgSpectrumBar from './SdgSpectrumBar.astro';
---

<footer class="w-full bg-inverse-surface text-inverse-on-surface mt-16 border-t border-white/10 print:hidden no-print">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 md:py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10">
      
      <!-- Brand & Zonal Headquarters -->
      <div class="lg:col-span-4 space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-lg bg-primary flex items-center justify-center text-white font-extrabold text-sm border border-secondary-container/70">
            SDG
          </div>
          <div>
            <span class="text-base font-extrabold text-white block leading-tight">NYSC Egor SDG CDS</span>
            <span class="font-mono text-[10px] text-secondary-fixed uppercase tracking-widest">Edo State • Chapter 24-B</span>
          </div>
        </div>
        <p class="text-xs text-white/70 leading-relaxed max-w-sm">
          Empowering Egor Local Government communities through youth-led sustainable innovations, civic advocacy, and transparent community development aligned with the UN 2030 Agenda.
        </p>
        <div class="pt-2 border-t border-white/10 text-xs">
          <p class="font-mono text-[10px] font-bold uppercase tracking-widest text-secondary-container">Secretariat Hub</p>
          <p class="text-white/85 mt-0.5">Egor NYSC Secretariat, Benin City, Edo State, Nigeria.</p>
        </div>
      </div>

      <!-- UN 17 Global Goals -->
      <div class="lg:col-span-3 space-y-3">
        <h4 class="font-mono text-[11px] font-bold text-secondary-container uppercase tracking-widest">
          Priority Global Goals
        </h4>
        <ul class="space-y-2 text-xs text-white/75">
          <li><a href="/#sdg-grid" class="hover:text-secondary-fixed transition-colors flex items-center gap-2"><span class="w-2 h-2 rounded-xs bg-[#4C9F38]"></span>Goal 3: Good Health & Well-being</a></li>
          <li><a href="/#sdg-grid" class="hover:text-secondary-fixed transition-colors flex items-center gap-2"><span class="w-2 h-2 rounded-xs bg-[#C5192D]"></span>Goal 4: Quality Education</a></li>
          <li><a href="/#sdg-grid" class="hover:text-secondary-fixed transition-colors flex items-center gap-2"><span class="w-2 h-2 rounded-xs bg-[#FF3A21]"></span>Goal 5: Gender Equality</a></li>
          <li><a href="/#sdg-grid" class="hover:text-secondary-fixed transition-colors flex items-center gap-2"><span class="w-2 h-2 rounded-xs bg-[#26BDE2]"></span>Goal 6: Clean Water & Sanitation</a></li>
          <li><a href="/#sdg-grid" class="hover:text-secondary-fixed transition-colors flex items-center gap-2"><span class="w-2 h-2 rounded-xs bg-[#FD9D24]"></span>Goal 11: Sustainable Communities</a></li>
          <li><a href="/#sdg-grid" class="hover:text-secondary-fixed transition-colors flex items-center gap-2"><span class="w-2 h-2 rounded-xs bg-[#3F7E44]"></span>Goal 13: Climate Action</a></li>
        </ul>
      </div>

      <!-- Community Partners -->
      <div class="lg:col-span-3 space-y-3">
        <h4 class="font-mono text-[11px] font-bold text-secondary-container uppercase tracking-widest">
          Civic & State Alliances
        </h4>
        <ul class="space-y-2 text-xs text-white/75">
          <li>Girls' Power Initiative (GPI) Nigeria</li>
          <li>Edo State Waste Management Board (ESWMB)</li>
          <li>Edo State SDGs Coordination Office</li>
          <li>Rotary Club of Benin (District 9141)</li>
          <li>Egor Public Secondary Schools & PHCs</li>
        </ul>
      </div>

      <!-- CDS Administrative Info -->
      <div class="lg:col-span-2 space-y-3">
        <h4 class="font-mono text-[11px] font-bold text-secondary-container uppercase tracking-widest">
          Weekly Assembly
        </h4>
        <div class="bg-white/5 border border-white/10 p-4 rounded-xl space-y-2">
          <p class="font-mono text-[10px] font-bold text-primary-fixed uppercase tracking-wider">
            Every Wednesday
          </p>
          <p class="text-sm font-extrabold text-white tabular-nums">
            9:00 AM WAT
          </p>
          <p class="text-[11px] text-white/70 leading-snug">
            Egor NYSC Secretariat, Benin City
          </p>
          <div class="pt-2 border-t border-white/10">
            <a class="text-xs text-secondary-container hover:underline font-bold inline-flex items-center gap-1" href="/admin">
              <span>Executive Login</span>
              <span class="material-symbols-outlined text-[14px]">lock</span>
            </a>
          </div>
        </div>
      </div>

    </div>

    <!-- Bottom Strip -->
    <div class="mt-12 pt-6 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-white/60">
      <p class="text-center sm:text-left font-mono text-[11px]">
        © 2026 NYSC EGOR SDG CDS GROUP • FEDERAL REPUBLIC OF NIGERIA
      </p>
      <div class="flex flex-wrap items-center justify-center gap-5 text-xs font-semibold">
        <a class="hover:text-white transition-colors" href="/projects">Projects</a>
        <a class="hover:text-white transition-colors" href="/ideas">Ideas Hub</a>
        <a class="hover:text-white transition-colors text-secondary-container font-bold" href="/partner">Partner / CSR</a>
        <a class="hover:text-white transition-colors" href="/events">Events</a>
        <a class="hover:text-white transition-colors" href="/blog">Blog</a>
      </div>
    </div>
  </div>
  <SdgSpectrumBar heightClass="h-1.5" />
</footer>
