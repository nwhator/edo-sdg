---
// Exactly 4 Main Nav Links with dropdown sub-links
const navItems = [
  {
    title: "Home",
    href: "/",
  },
  {
    title: "Ideas Hub",
    href: "/ideas",
    subLinks: [
      { title: "Browse & Vote on Ideas", href: "/ideas", desc: "Peer-voted community initiatives" },
      { title: "Drop Anonymous Idea", href: "/ideas#drop", desc: "Share suggestions without exposing identity" },
    ]
  },
  {
    title: "Projects & Gallery",
    href: "/projects",
    subLinks: [
      { title: "CDS Projects & Budgets", href: "/projects", desc: "Approved initiatives and budgets" },
      { title: "Event Photo Albums", href: "/gallery", desc: "Visual records organized by event" },
    ]
  },
  {
    title: "SDG Portal (Admin)",
    href: "/admin",
    isProtected: true,
    subLinks: [
      { title: "Executive Dashboard", href: "/admin", desc: "Project planning & internal controls" },
      { title: "Benin NGO Directory", href: "/admin/funding", desc: "Vetted partners for pads & cleaning materials" },
      { title: "Sponsorship Pitch Kit", href: "/admin/pitch-kit", desc: "Official pitch letter drafts" },
      { title: "Idea Moderation", href: "/admin/ideas", desc: "Review and approve anonymous submissions" },
    ]
  }
];

const pathname = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur border-b border-slate-200 shadow-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo / Identity -->
      <a href="/" class="flex items-center gap-3.5 group">
        <div class="relative w-12 h-12 rounded-xl bg-nysc-green flex items-center justify-center text-white font-bold shadow-md shadow-nysc-green/20 ring-2 ring-nysc-gold transition-transform group-hover:scale-105">
          <span class="text-xl tracking-tighter">SDG</span>
          <span class="absolute -bottom-1 -right-1 w-4 h-4 rounded-full bg-nysc-gold border-2 border-white flex items-center justify-center text-[9px] text-nysc-green-dark font-extrabold">E</span>
        </div>
        <div>
          <div class="flex items-center gap-1.5">
            <span class="text-xs font-bold tracking-wider uppercase text-nysc-gold-dark bg-amber-50 px-2 py-0.5 rounded-full border border-amber-200">
              Edo State Chapter
            </span>
          </div>
          <h1 class="text-lg font-black tracking-tight text-slate-900 group-hover:text-nysc-green transition-colors">
            NYSC SDG CDS Group
          </h1>
          <p class="text-[11px] text-slate-500 font-medium">Service & Humility · Benin City</p>
        </div>
      </a>

      <!-- Desktop Navigation: EXACTLY 4 MAIN LINKS -->
      <nav class="hidden md:flex items-center space-x-1 lg:space-x-2">
        {navItems.map((item) => {
          const isActive = item.href === '/' 
            ? pathname === '/' 
            : pathname.startsWith(item.href);

          return (
            <div class="relative group">
              <a
                href={item.href}
                class={`flex items-center gap-1.5 px-3.5 py-2 rounded-lg text-sm font-semibold transition-all duration-150 ${
                  isActive
                    ? 'text-nysc-green bg-green-50/80 shadow-xs ring-1 ring-nysc-green/20'
                    : 'text-slate-700 hover:text-nysc-green hover:bg-slate-50'
                }`}
              >
                <span>{item.title}</span>
                {item.isProtected && (
                  <span class="text-xs opacity-75">🔒</span>
                )}
                {item.subLinks && (
                  <svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-nysc-green transition-transform duration-200 group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                )}
              </a>

              {/* Dropdown Sub-links */}
              {item.subLinks && (
                <div class="absolute left-0 mt-1 w-72 p-2 bg-white rounded-xl shadow-xl border border-slate-100 opacity-0 translate-y-2 pointer-events-none group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto transition-all duration-200 z-50">
                  <div class="space-y-1">
                    {item.subLinks.map((sub) => (
                      <a
                        href={sub.href}
                        class="block px-3 py-2.5 rounded-lg hover:bg-slate-50 transition-colors group/sub"
                      >
                        <div class="text-sm font-semibold text-slate-800 group-hover/sub:text-nysc-green">
                          {sub.title}
                        </div>
                        <div class="text-xs text-slate-500 line-clamp-1 mt-0.5">
                          {sub.desc}
                        </div>
                      </a>
                    ))}
                  </div>
                </div>
              )}
            </div>
          );
        })}
      </nav>

      <!-- Action Button / Header CTA -->
      <div class="hidden sm:flex items-center gap-3">
        <a
          href="/ideas"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-nysc-green text-white text-sm font-semibold hover:bg-nysc-green-dark shadow-xs shadow-nysc-green/30 transition-all hover:-translate-y-0.5"
        >
          <svg class="w-4 h-4 text-nysc-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
          </svg>
          <span>Drop Anonymous Idea</span>
        </a>
        <a
          href="/admin"
          class="p-2 rounded-lg text-slate-600 hover:text-nysc-green hover:bg-slate-100 transition-colors"
          title="SDG Admin Portal"
        >
          <span class="text-sm">🔒</span>
        </a>
      </div>

      <!-- Mobile Menu Toggle Button -->
      <div class="flex md:hidden items-center">
        <button
          id="mobile-menu-button"
          type="button"
          class="p-2 rounded-lg text-slate-600 hover:text-slate-900 hover:bg-slate-100 focus:outline-hidden"
          aria-label="Toggle navigation menu"
        >
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-slate-200 bg-white px-4 pt-3 pb-6 space-y-4">
    {navItems.map((item) => (
      <div class="space-y-1">
        <a
          href={item.href}
          class="block px-3 py-2 rounded-md text-base font-bold text-slate-800 hover:text-nysc-green hover:bg-slate-50"
        >
          {item.title} {item.isProtected && '🔒'}
        </a>
        {item.subLinks && (
          <div class="pl-4 space-y-1 border-l-2 border-slate-100 ml-3">
            {item.subLinks.map((sub) => (
              <a
                href={sub.href}
                class="block px-2 py-1.5 text-sm font-medium text-slate-600 hover:text-nysc-green"
              >
                {sub.title}
              </a>
            ))}
          </div>
        )}
      </div>
    ))}

    <div class="pt-4 border-t border-slate-100 flex flex-col gap-2">
      <a
        href="/ideas"
        class="w-full text-center py-2.5 px-4 rounded-lg bg-nysc-green text-white font-semibold text-sm shadow-sm"
      >
        Drop Anonymous Idea
      </a>
      <a
        href="/admin"
        class="w-full text-center py-2.5 px-4 rounded-lg border border-slate-300 text-slate-700 font-semibold text-sm"
      >
        SDG Admin Portal 🔒
      </a>
    </div>
  </div>
</header>

<script>
  const menuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');

  if (menuButton && mobileMenu) {
    menuButton.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
  }
</script>
