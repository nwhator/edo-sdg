---
// Exactly 4 Main Nav Links with dropdown sub-links
const navItems = [
  {
    title: "Home",
    href: "/",
  },
  {
    title: "Projects & Gallery",
    href: "/projects",
    subLinks: [
      { title: "Planned Initiatives & Budgets", href: "/projects", desc: "Cost breakdowns, SDGs, & target partners" },
      { title: "Event Photo Albums", href: "/gallery", desc: "Outreach gallery grouped by events" },
    ]
  },
  {
    title: "Ideas Hub",
    href: "/ideas",
    subLinks: [
      { title: "Browse & Upvote Ideas", href: "/ideas", desc: "Vote on community-driven proposals" },
      { title: "Drop Anonymous Idea", href: "/ideas#drop", desc: "Pitch community solutions without your name" },
    ]
  },
  {
    title: "SDG Portal (Admin)",
    href: "/admin",
    isProtected: true,
    subLinks: [
      { title: "Executive Dashboard", href: "/admin", desc: "Project planning, internal files & photos" },
      { title: "Benin NGO Directory", href: "/admin/funding", desc: "Vetted partners for pads & cleaning materials" },
      { title: "Sponsorship Pitch Kit", href: "/admin/pitch-kit", desc: "Official NYSC CDS letters & pitch templates" },
      { title: "Idea Moderation", href: "/admin/ideas", desc: "Review and approve anonymous submissions" },
    ]
  }
];

const pathname = Astro.url.pathname;
---

<header class="fixed top-0 w-full z-50 bg-surface-container-lowest/95 backdrop-blur-md shadow-[0_1px_8px_rgba(0,0,0,0.04)] border-b border-surface-container-high/60">
  <div class="h-20 max-w-7xl mx-auto px-margin-mobile md:px-margin-desktop flex items-center justify-between">
    
    <!-- Brand Identity -->
    <a href="/" class="flex items-center gap-space-md group">
      <div class="relative w-11 h-11 rounded-xl bg-primary flex items-center justify-center text-on-primary font-bold shadow-md ring-2 ring-secondary-container transition-transform group-hover:scale-105">
        <span class="font-display text-lg tracking-tighter">SDG</span>
        <span class="absolute -bottom-1 -right-1 w-4 h-4 rounded-full bg-secondary-container border-2 border-surface-container-lowest flex items-center justify-center text-[9px] text-on-secondary-container font-extrabold">E</span>
      </div>
      <div class="flex flex-col">
        <span class="font-title-md text-title-md text-primary font-bold leading-tight group-hover:text-primary-container transition-colors">
          NYSC Edo SDG CDS
        </span>
        <span class="font-label-sm text-label-sm text-on-surface-variant font-medium tracking-normal flex items-center gap-1">
          <span>Benin City, Edo State</span>
          <span class="text-secondary-fixed-variant">•</span>
          <span class="text-secondary font-semibold">Under 2030 Agenda</span>
        </span>
      </div>
    </a>

    <!-- Desktop Navigation: EXACTLY 4 MAIN LINKS -->
    <nav class="hidden lg:flex items-center gap-space-lg xl:gap-space-xl">
      {navItems.map((item) => {
        const isActive = item.href === '/' 
          ? pathname === '/' 
          : pathname.startsWith(item.href);

        return (
          <div class="relative group">
            <a
              href={item.href}
              class={`flex items-center gap-1.5 py-2 font-label-lg text-label-lg transition-colors ${
                isActive
                  ? 'text-primary font-bold'
                  : 'text-on-surface-variant hover:text-on-surface font-semibold'
              }`}
            >
              <span>{item.title}</span>
              {item.isProtected && (
                <span class="material-symbols-outlined text-[15px] text-secondary">lock</span>
              )}
              {item.subLinks && (
                <span class="material-symbols-outlined text-[18px] text-outline group-hover:text-primary transition-transform duration-200 group-hover:rotate-180">
                  expand_more
                </span>
              )}
            </a>

            {/* Dropdown Sub-links */}
            {item.subLinks && (
              <div class="absolute left-0 mt-1 w-72 p-2 bg-surface-container-lowest rounded-xl shadow-xl border border-surface-container-high opacity-0 translate-y-2 pointer-events-none group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto transition-all duration-200 z-50">
                <div class="space-y-1">
                  {item.subLinks.map((sub) => (
                    <a
                      href={sub.href}
                      class="block px-3 py-2.5 rounded-lg hover:bg-surface-container-low transition-colors group/sub"
                    >
                      <div class="font-label-md text-label-md font-bold text-on-surface group-hover/sub:text-primary">
                        {sub.title}
                      </div>
                      <div class="font-body-sm text-xs text-on-surface-variant line-clamp-1 mt-0.5">
                        {sub.desc}
                      </div>
                    </a>
                  ))}
                </div>
              </div>
            )}
          </div>
        );
      })}
    </nav>

    <!-- Header Actions -->
    <div class="flex items-center gap-space-md">
      <a
        href="/ideas#drop"
        class="hidden sm:inline-flex items-center gap-space-xs px-space-md py-space-sm bg-primary hover:bg-primary-container text-on-primary font-label-lg text-label-lg rounded-lg shadow-sm transition-colors"
      >
        <span class="material-symbols-outlined text-[18px]">add</span>
        <span>Drop Idea</span>
      </a>

      <a
        href="/admin"
        class="w-9 h-9 rounded-full bg-primary flex items-center justify-center shadow-sm ring-2 ring-secondary-container hover:opacity-95 transition-opacity"
        title="Executive Admin Portal"
      >
        <span class="material-symbols-outlined text-on-primary text-[18px]">lock</span>
      </a>

      <!-- Mobile Menu Toggle Button -->
      <button
        id="mobile-menu-button"
        type="button"
        class="lg:hidden p-2 rounded-lg text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high focus:outline-hidden"
        aria-label="Toggle navigation menu"
      >
        <span class="material-symbols-outlined text-[24px]">menu</span>
      </button>
    </div>

  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-surface-container-high bg-surface-container-lowest px-4 pt-3 pb-6 space-y-4">
    {navItems.map((item) => (
      <div class="space-y-1">
        <a
          href={item.href}
          class="block px-3 py-2 rounded-lg font-headline-sm text-sm font-bold text-on-surface hover:text-primary hover:bg-surface-container-low"
        >
          {item.title} {item.isProtected && '🔒'}
        </a>
        {item.subLinks && (
          <div class="pl-4 space-y-1 border-l-2 border-surface-container-high ml-3">
            {item.subLinks.map((sub) => (
              <a
                href={sub.href}
                class="block px-2 py-1.5 font-body-sm text-xs text-on-surface-variant hover:text-primary"
              >
                {sub.title}
              </a>
            ))}
          </div>
        )}
      </div>
    ))}

    <div class="pt-4 border-t border-surface-container-high flex flex-col gap-2">
      <a
        href="/ideas#drop"
        class="w-full text-center py-2.5 px-4 rounded-lg bg-primary text-on-primary font-label-lg text-label-lg font-bold shadow-sm"
      >
        + Drop Anonymous Idea
      </a>
      <a
        href="/admin"
        class="w-full text-center py-2.5 px-4 rounded-lg border border-surface-container-high text-on-surface font-label-lg text-label-lg font-semibold"
      >
        SDG Executive Portal 🔒
      </a>
    </div>
  </div>
</header>

<script>
  const menuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');

  if (menuButton && mobileMenu) {
    menuButton.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
  }
</script>
