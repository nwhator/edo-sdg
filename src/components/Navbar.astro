---
// Navigation Links with dropdown sub-links
const navItems = [
  {
    title: "Home",
    href: "/",
  },
  {
    title: "Events",
    href: "/events",
    subLinks: [
      { title: "Community Outreaches", href: "/events", desc: "Outreach events and photo archives" },
      { title: "Ogida Market Sensitization", href: "/events#evt-ogida-education-sensitization", desc: "SDG 4 outreach & 28 photo plates" },
      { title: "Printable LGI Reports", href: "/gallery/report", desc: "Simple B&W statutory reports for LGI" },
    ]
  },
  {
    title: "Blog",
    href: "/blog",
    subLinks: [
      { title: "All Stories & Articles", href: "/blog", desc: "Impact reports, sensitizations & press" },
      { title: "Ogida Market SDG 4 Story", href: "/blog/ogida-market-quality-education", desc: "Debunking 'education is a scam' narrative" },
    ]
  },
  {
    title: "Projects",
    href: "/projects",
    subLinks: [
      { title: "Planned Projects & Budgets", href: "/projects", desc: "Itemized costs, SDGs & partner plans" },
    ]
  },
  {
    title: "Ideas Hub",
    href: "/ideas",
    subLinks: [
      { title: "Browse Community Ideas", href: "/ideas", desc: "Vote on peer-submitted proposals" },
      { title: "Submit an Idea", href: "/ideas#drop", desc: "Pitch an anonymous project for Egor" },
    ]
  },
  {
    title: "Partner / CSR",
    href: "/partner",
    subLinks: [
      { title: "Corporate CSR & Donors", href: "/partner", desc: "Co-sponsor verified grassroots SDG projects" },
      { title: "Impact Calculator", href: "/partner#calculator", desc: "Calculate verified community reach per Naira" },
      { title: "Sponsorship Tiers", href: "/partner#tiers", desc: "Bronze, Silver, Gold & Flagship perks" },
    ]
  },
  {
    title: "SDG Portal",
    href: "/admin",
    isProtected: true,
    subLinks: [
      { title: "Executive Dashboard", href: "/admin", desc: "Overview, planning & media uploads" },
      { title: "NGO Partner Directory", href: "/admin/funding", desc: "Local NGO partners & state boards" },
      { title: "NGO Radar & Crawler", href: "/admin/radar", desc: "Discover & crawl Edo SDG organizations" },
      { title: "Official Pitch Kit", href: "/admin/pitch-kit", desc: "Pre-drafted sponsorship & requisition letters" },
      { title: "Review Submissions", href: "/admin/ideas", desc: "Review and approve community ideas" },
    ]
  }
];

const pathname = Astro.url.pathname;
---

<header class="fixed top-0 w-full z-50 bg-surface/95 backdrop-blur-md border-b border-surface-container shadow-subtle">
  <div class="h-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between gap-4">
    
    <!-- Brand Identity -->
    <a href="/" class="flex items-center gap-3 group shrink-0">
      <div class="w-10 h-10 rounded-xl bg-primary flex items-center justify-center text-on-primary font-extrabold shadow-sm ring-2 ring-secondary-container transition-transform group-hover:scale-105">
        <span class="font-display text-base tracking-tight">SDG</span>
      </div>
      <div class="flex flex-col">
        <span class="font-headline-sm text-sm sm:text-base text-primary font-bold leading-tight group-hover:text-primary-container transition-colors">
          NYSC Egor SDG CDS
        </span>
        <span class="font-label-sm text-[11px] text-on-surface-variant font-medium flex items-center gap-1">
          <span>Egor NYSC Secretariat</span>
          <span class="text-secondary">•</span>
          <span class="text-secondary font-semibold">2030 Agenda</span>
        </span>
      </div>
    </a>

    <!-- Desktop Navigation: EXACTLY 4 MAIN LINKS -->
    <nav class="hidden lg:flex items-center gap-1 xl:gap-2">
      {navItems.map((item) => {
        const isActive = item.href === '/' 
          ? pathname === '/' 
          : pathname.startsWith(item.href);

        return (
          <div class="relative group">
            <a
              href={item.href}
              class={`flex items-center gap-1 px-3 py-2 rounded-lg font-label-md text-sm transition-colors ${
                isActive
                  ? 'bg-surface-container text-primary font-bold'
                  : 'text-on-surface-variant hover:text-on-surface hover:bg-surface-container/60 font-semibold'
              }`}
            >
              <span>{item.title}</span>
              {item.isProtected && (
                <span class="material-symbols-outlined text-[15px] text-secondary">lock</span>
              )}
              {item.subLinks && (
                <span class="material-symbols-outlined text-[18px] text-outline group-hover:text-primary transition-transform duration-200 group-hover:rotate-180">
                  expand_more
                </span>
              )}
            </a>

            {/* Dropdown Sub-links */}
            {item.subLinks && (
              <div class="absolute left-0 mt-1 w-64 p-2 bg-surface-container-lowest rounded-xl shadow-card border border-surface-container opacity-0 translate-y-2 pointer-events-none group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto transition-all duration-200 z-50">
                <div class="space-y-1">
                  {item.subLinks.map((sub) => (
                    <a
                      href={sub.href}
                      class="block px-3 py-2 rounded-lg hover:bg-surface-container-low transition-colors group/sub"
                    >
                      <div class="font-label-md text-xs font-bold text-on-surface group-hover/sub:text-primary">
                        {sub.title}
                      </div>
                      <div class="font-body-sm text-[11px] text-on-surface-variant line-clamp-1 mt-0.5">
                        {sub.desc}
                      </div>
                    </a>
                  ))}
                </div>
              </div>
            )}
          </div>
        );
      })}
    </nav>

    <!-- Header Actions / Understandable CTAs -->
    <div class="flex items-center gap-2 sm:gap-3">
      <a
        href="/ideas#drop"
        class="hidden lg:inline-flex items-center justify-center gap-1.5 h-10 px-4 rounded-xl bg-primary hover:bg-primary-container text-on-primary font-label-md text-xs sm:text-sm font-bold shadow-sm active:scale-95 transition-all"
      >
        <span class="material-symbols-outlined text-[18px]">lightbulb</span>
        <span>Submit an Idea</span>
      </a>

      <a
        href="/admin"
        class="hidden lg:inline-flex items-center justify-center gap-1.5 h-10 px-3 rounded-xl border border-surface-container-high bg-surface-container-lowest hover:bg-surface-container text-on-surface text-xs font-bold transition-all shadow-subtle"
        title="Restricted SDG Executive Portal"
      >
        <span class="material-symbols-outlined text-[16px] text-secondary">lock</span>
        <span>Login</span>
      </a>

      <!-- Mobile Menu Toggle Button -->
      <button
        id="mobile-menu-button"
        type="button"
        class="lg:hidden p-2 rounded-xl text-on-surface-variant hover:text-on-surface hover:bg-surface-container focus:outline-hidden"
        aria-label="Toggle navigation menu"
      >
        <span class="material-symbols-outlined text-[26px]">menu</span>
      </button>
    </div>

  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-surface-container bg-surface/98 backdrop-blur-md px-4 pt-3 pb-6 space-y-3 shadow-lg">
    {navItems.map((item) => (
      <div class="space-y-1">
        <a
          href={item.href}
          class="block px-3 py-2 rounded-lg font-headline-sm text-sm font-bold text-on-surface hover:text-primary hover:bg-surface-container-low"
        >
          {item.title} {item.isProtected && '🔒'}
        </a>
        {item.subLinks && (
          <div class="pl-4 space-y-1 border-l-2 border-surface-container ml-3">
            {item.subLinks.map((sub) => (
              <a
                href={sub.href}
                class="block px-2 py-1.5 font-body-sm text-xs text-on-surface-variant hover:text-primary"
              >
                {sub.title}
              </a>
            ))}
          </div>
        )}
      </div>
    ))}

    <!-- Mobile CTAs inside dropdown -->
    <div class="pt-3 mt-2 border-t border-surface-container flex flex-col gap-2.5">
      <a
        href="/ideas#drop"
        class="w-full text-center py-3 px-4 rounded-xl bg-primary hover:bg-primary-container text-on-primary font-label-md text-sm font-bold shadow-sm flex items-center justify-center gap-2 active:scale-98 transition-all"
      >
        <span class="material-symbols-outlined text-[18px]">lightbulb</span>
        <span>Submit an Idea</span>
      </a>
      <a
        href="/admin"
        class="w-full text-center py-2.5 px-4 rounded-xl border border-surface-container-high bg-surface-container-lowest hover:bg-surface-container text-on-surface font-label-md text-sm font-semibold flex items-center justify-center gap-2 active:scale-98 transition-all"
      >
        <span class="material-symbols-outlined text-[16px] text-secondary">lock</span>
        <span>Login</span>
      </a>
    </div>
  </div>
</header>

<script is:inline>
  const menuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');

  if (menuButton && mobileMenu) {
    menuButton.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
  }
</script>
