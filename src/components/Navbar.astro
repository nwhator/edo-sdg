---
import SdgSpectrumBar from './SdgSpectrumBar.astro';

const navItems = [
  {
    title: "Home",
    href: "/",
  },
  {
    title: "Events",
    href: "/events",
    subLinks: [
      { title: "Community Outreaches", href: "/events", desc: "Outreach events and photo archives" },
      { title: "Uwelu Market Sanitation (SDG 6)", href: "/events#evt-uwelu-market-sanitation-sdg6", desc: "Nov 25 sanitation & 32 photo plates" },
      { title: "Ogida Market Sensitization", href: "/events#evt-ogida-education-sensitization", desc: "SDG 4 outreach & photo plates" },
    ]
  },
  {
    title: "Blog",
    href: "/blog",
    subLinks: [
      { title: "All Stories & Articles", href: "/blog", desc: "Impact reports, sensitizations & press" },
      { title: "Uwelu Market SDG 6 Report", href: "/blog/uwelu-market-environmental-sanitation-sdg-6", desc: "Clean water, sanitation & 10+ bags evacuated" },
      { title: "Ogida Market SDG 4 Story", href: "/blog/ogida-market-quality-education", desc: "Debunking 'education is a scam' narrative" },
    ]
  },
  {
    title: "Projects",
    href: "/projects",
    subLinks: [
      { title: "Planned Projects & Budgets", href: "/projects", desc: "Itemized costs, SDGs & partner plans" },
    ]
  },
  {
    title: "Ideas Hub",
    href: "/ideas",
    subLinks: [
      { title: "Browse Community Ideas", href: "/ideas", desc: "Vote on peer-submitted proposals" },
      { title: "Submit an Idea", href: "/ideas#drop", desc: "Pitch an anonymous project for Egor" },
    ]
  },
  {
    title: "Partner / CSR",
    href: "/partner",
    subLinks: [
      { title: "Corporate CSR & Donors", href: "/partner", desc: "Co-sponsor verified grassroots SDG projects" },
      { title: "Impact Calculator", href: "/partner#calculator", desc: "Calculate verified community reach per Naira" },
      { title: "Sponsorship Tiers", href: "/partner#tiers", desc: "Bronze, Silver, Gold & Flagship perks" },
    ]
  },
  {
    title: "SDG Portal",
    href: "/admin",
    isProtected: true,
    subLinks: [
      { title: "Executive Dashboard", href: "/admin", desc: "Overview, planning & media uploads" },
      { title: "Printable LGI Report", href: "/admin/report", desc: "Statutory report for LGI (Admin only)" },
      { title: "NGO Partner Directory", href: "/admin/funding", desc: "Local NGO partners & state boards" },
      { title: "NGO Radar & Crawler", href: "/admin/radar", desc: "Discover & crawl Edo SDG organizations" },
      { title: "Official Pitch Kit", href: "/admin/pitch-kit", desc: "Pre-drafted sponsorship & requisition letters" },
      { title: "Review Submissions", href: "/admin/ideas", desc: "Review and approve community ideas" },
    ]
  }
];

const pathname = Astro.url.pathname;
---

<header class="fixed top-0 w-full z-50 bg-surface/95 backdrop-blur-md border-b border-on-surface/10 print:hidden no-print">
  <SdgSpectrumBar heightClass="h-[3px]" />
  <div class="h-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between gap-4">
    
    <!-- Brand Identity -->
    <a href="/" class="flex items-center gap-3 group shrink-0">
      <div class="relative w-10 h-10 rounded-lg bg-primary flex items-center justify-center text-on-primary font-extrabold shadow-subtle border border-secondary-container/70 transition-transform group-hover:-translate-y-0.5">
        <span class="font-display text-sm tracking-tighter">SDG</span>
        <span class="absolute -bottom-1 -right-1 w-3 h-3 rounded-full bg-secondary-container border-2 border-surface"></span>
      </div>
      <div class="flex flex-col">
        <span class="font-display text-sm sm:text-[15px] text-on-surface font-extrabold tracking-tight leading-tight group-hover:text-primary transition-colors">
          NYSC Egor SDG CDS
        </span>
        <span class="font-mono text-[10px] text-on-surface-variant uppercase tracking-wider flex items-center gap-1.5">
          <span>Edo State</span>
          <span class="text-secondary">•</span>
          <span class="text-primary font-bold">2030 Agenda</span>
        </span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden lg:flex items-center gap-0.5 xl:gap-1">
      {navItems.map((item) => {
        const isActive = item.href === '/' 
          ? pathname === '/' 
          : pathname.startsWith(item.href);

        return (
          <div class="relative group">
            <a
              href={item.href}
              class={`flex items-center gap-1 px-3 py-2 rounded-lg text-[13px] transition-all ${
                isActive
                  ? 'bg-primary text-on-primary font-bold shadow-subtle'
                  : 'text-on-surface-variant hover:text-on-surface hover:bg-surface-container-low font-semibold'
              }`}
            >
              <span>{item.title}</span>
              {item.isProtected && (
                <span class={`material-symbols-outlined text-[14px] ${isActive ? 'text-secondary-container' : 'text-secondary'}`}>lock</span>
              )}
              {item.subLinks && (
                <span class={`material-symbols-outlined text-[16px] transition-transform duration-200 group-hover:rotate-180 ${isActive ? 'text-on-primary/80' : 'text-outline'}`}>
                  expand_more
                </span>
              )}
            </a>

            {/* Dropdown Sub-links */}
            {item.subLinks && (
              <div class="absolute left-0 mt-1.5 w-68 p-2 bg-surface-container-lowest rounded-xl shadow-elevated border border-on-surface/10 opacity-0 translate-y-2 pointer-events-none group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto transition-all duration-200 z-50">
                <div class="space-y-0.5">
                  {item.subLinks.map((sub) => (
                    <a
                      href={sub.href}
                      class="block px-3 py-2 rounded-lg hover:bg-surface-container-low transition-colors group/sub"
                    >
                      <div class="text-xs font-bold text-on-surface group-hover/sub:text-primary flex items-center justify-between">
                        <span>{sub.title}</span>
                        <span class="material-symbols-outlined text-[14px] opacity-0 group-hover/sub:opacity-100 transition-opacity text-primary">arrow_forward</span>
                      </div>
                      <div class="text-[11px] text-on-surface-variant line-clamp-1 mt-0.5">
                        {sub.desc}
                      </div>
                    </a>
                  ))}
                </div>
              </div>
            )}
          </div>
        );
      })}
    </nav>

    <!-- Header Actions -->
    <div class="flex items-center gap-2">
      <a
        href="/ideas#drop"
        class="hidden lg:inline-flex items-center justify-center gap-1.5 h-9 px-4 rounded-lg bg-secondary-container hover:bg-secondary-fixed text-on-secondary-container text-xs font-extrabold tracking-tight shadow-subtle active:scale-95 transition-all border border-secondary/20"
      >
        <span class="material-symbols-outlined text-[16px]">lightbulb</span>
        <span>Submit Idea</span>
      </a>

      <a
        href="/admin"
        class="hidden lg:inline-flex items-center justify-center gap-1.5 h-9 px-3 rounded-lg border border-on-surface/15 bg-surface-container-lowest hover:bg-surface-container-low text-on-surface text-xs font-bold transition-all"
        title="Restricted SDG Executive Portal"
      >
        <span class="material-symbols-outlined text-[15px] text-primary">lock</span>
        <span>Portal</span>
      </a>

      <!-- Mobile Menu Toggle Button -->
      <button
        id="mobile-menu-button"
        type="button"
        class="lg:hidden p-2 rounded-lg text-on-surface hover:bg-surface-container-low border border-on-surface/10 focus:outline-hidden"
        aria-label="Toggle navigation menu"
      >
        <span class="material-symbols-outlined text-[24px]">menu</span>
      </button>
    </div>

  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-on-surface/10 bg-surface/98 backdrop-blur-md px-4 pt-3 pb-6 space-y-3 shadow-elevated max-h-[82vh] overflow-y-auto">
    {navItems.map((item) => (
      <div class="space-y-1">
        <a
          href={item.href}
          class="block px-3 py-2 rounded-lg font-display text-sm font-bold text-on-surface hover:text-primary hover:bg-surface-container-low"
        >
          {item.title} {item.isProtected && '🔒'}
        </a>
        {item.subLinks && (
          <div class="pl-4 space-y-1 border-l-2 border-primary/20 ml-3">
            {item.subLinks.map((sub) => (
              <a
                href={sub.href}
                class="block px-2 py-1.5 text-xs text-on-surface-variant hover:text-primary font-medium"
              >
                {sub.title}
              </a>
            ))}
          </div>
        )}
      </div>
    ))}

    <!-- Mobile CTAs inside dropdown -->
    <div class="pt-3 mt-2 border-t border-on-surface/10 flex flex-col gap-2.5">
      <a
        href="/ideas#drop"
        class="w-full text-center py-3 px-4 rounded-lg bg-primary hover:bg-primary-container text-on-primary text-sm font-bold shadow-subtle flex items-center justify-center gap-2 transition-all"
      >
        <span class="material-symbols-outlined text-[18px]">lightbulb</span>
        <span>Submit an Idea</span>
      </a>
      <a
        href="/admin"
        class="w-full text-center py-2.5 px-4 rounded-lg border border-on-surface/15 bg-surface-container-lowest hover:bg-surface-container-low text-on-surface text-sm font-semibold flex items-center justify-center gap-2 transition-all"
      >
        <span class="material-symbols-outlined text-[16px] text-primary">lock</span>
        <span>Executive Portal Login</span>
      </a>
    </div>
  </div>
</header>

<script is:inline>
  const menuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');

  if (menuButton && mobileMenu) {
    menuButton.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
  }
</script>
