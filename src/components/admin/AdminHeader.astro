---
const pathname = Astro.url.pathname;

const tabs = [
  { label: 'Command Center', href: '/admin', icon: 'admin_panel_settings' },
  { label: 'Review Ideas', href: '/admin/ideas', icon: 'lightbulb' },
  { label: '+ Plan Project', href: '/admin/projects/new', icon: 'account_balance_wallet' },
  { label: '📸 Upload Photos', href: '/admin/gallery/new', icon: 'add_photo_alternate' },
  { label: '🔍 NGO Radar', href: '/admin/radar', icon: 'radar' },
  { label: 'NGO Directory', href: '/admin/funding', icon: 'corporate_fare' },
  { label: 'Pitch Kit & Letters', href: '/admin/pitch-kit', icon: 'folder_special' },
];
---

<div class="space-y-space-md pb-space-lg border-b border-surface-container-high">
  <!-- Top Command Bar -->
  <div class="bg-surface-container-lowest p-space-lg rounded-2xl shadow-sm border border-surface-container-high flex flex-col md:flex-row md:items-center md:justify-between gap-space-md">
    <div class="flex items-start md:items-center gap-space-md">
      <div class="w-12 h-12 rounded-xl bg-primary flex items-center justify-center text-on-primary shadow-sm flex-shrink-0">
        <span class="material-symbols-outlined text-[28px]">verified_user</span>
      </div>
      <div class="flex flex-col min-w-0">
        <div class="flex items-center gap-space-xs flex-wrap">
          <span class="font-headline-sm text-headline-sm text-on-surface font-bold">
            CDS Executive Command Center
          </span>
          <span class="bg-error-container text-on-error-container font-label-sm text-label-sm px-space-xs py-0.5 rounded uppercase tracking-wider font-bold">
            Protected Zone
          </span>
          <span
            id="admin-user-pill"
            class="bg-primary-fixed text-on-primary-fixed font-label-sm text-label-sm px-space-sm py-0.5 rounded-full font-bold flex items-center gap-1"
          >
            <span class="material-symbols-outlined text-[14px]">account_circle</span>
            <span id="admin-user-name">Executive</span>
          </span>
        </div>
        <p class="font-body-sm text-body-sm text-on-surface-variant truncate">
          NYSC Edo State Secretariat • Schedule Officer: <span class="text-primary font-medium">Mrs. A. Osagie (NYSC Secretariat, Benin City)</span>
        </p>
      </div>
    </div>

    <!-- Quick User & Action Status -->
    <div class="flex items-center gap-space-sm flex-wrap self-start md:self-auto">
      <a
        href="/"
        class="font-label-sm text-label-sm text-on-surface-variant hover:text-primary transition-colors px-3 py-1.5 rounded-lg border border-surface-container-high bg-surface-container-lowest"
      >
        Public Site ↗
      </a>
      <button
        id="admin-logout-btn"
        type="button"
        class="px-3.5 py-1.5 rounded-lg bg-error-container text-on-error-container hover:opacity-90 font-label-sm text-label-sm font-bold transition-all flex items-center gap-1"
      >
        <span class="material-symbols-outlined text-[16px]">logout</span>
        <span>Sign Out</span>
      </button>
    </div>
  </div>

  <!-- Workspace Navigation Tabs -->
  <nav class="bg-surface-container p-1 rounded-xl shadow-sm flex flex-wrap gap-1">
    {tabs.map((tab) => {
      const isCurrent = tab.href === '/admin' ? pathname === '/admin' : pathname.startsWith(tab.href);
      return (
        <a
          href={tab.href}
          class={`flex items-center gap-space-xs px-space-md py-space-sm rounded-lg font-label-md text-label-md transition-all duration-150 ${
            isCurrent
              ? 'bg-primary text-on-primary font-bold shadow-sm'
              : 'text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high font-medium'
          }`}
        >
          <span class="material-symbols-outlined text-[18px]">{tab.icon}</span>
          <span>{tab.label}</span>
        </a>
      );
    })}
  </nav>
</div>

<script>
  import { supabase } from '../../lib/supabase';

  async function enforceAuth() {
    let isAuthenticated = false;
    if (supabase) {
      try {
        const { data } = await supabase.auth.getSession();
        if (data.session) {
          isAuthenticated = true;
        }
      } catch (err) {
        // Fallback to token check
      }
    }

    if (!isAuthenticated) {
      const localToken = localStorage.getItem('edo_sdg_admin_token');
      if (localToken) {
        isAuthenticated = true;
      }
    }

    if (!isAuthenticated) {
      window.location.href = '/admin/login';
      return;
    }

    // Populate active user badge
    const userNameEl = document.getElementById('admin-user-name');
    if (userNameEl) {
      const name = localStorage.getItem('edo_sdg_admin_name');
      const role = localStorage.getItem('edo_sdg_admin_role');
      const email = localStorage.getItem('edo_sdg_admin_email');

      if (name && role) {
        userNameEl.textContent = `${name} (${role})`;
      } else if (name) {
        userNameEl.textContent = name;
      } else if (email) {
        userNameEl.textContent = email;
      } else {
        userNameEl.textContent = 'Super Admin';
      }
    }
  }

  enforceAuth();

  const logoutBtn = document.getElementById('admin-logout-btn');
  if (logoutBtn) {
    logoutBtn.addEventListener('click', async () => {
      if (supabase) {
        try {
          await supabase.auth.signOut();
        } catch {
          // ignore
        }
      }
      localStorage.removeItem('edo_sdg_admin_token');
      localStorage.removeItem('edo_sdg_admin_email');
      localStorage.removeItem('edo_sdg_admin_name');
      localStorage.removeItem('edo_sdg_admin_role');
      window.location.href = '/admin/login';
    });
  }
</script>
