---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { 
  title, 
  description = "Official platform for the Edo State NYSC Sustainable Development Goals (SDG) CDS Group. Anonymous idea submission, project planning, community outreach gallery, and NGO funding partnerships in Benin City." 
} = Astro.props;
---

<!doctype html>
<html lang="en" class="h-full scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><circle cx='50' cy='50' r='48' fill='%23006633'/><circle cx='50' cy='50' r='38' fill='none' stroke='%23F4C430' stroke-width='6'/><text x='50' y='62' font-size='32' font-weight='900' text-anchor='middle' fill='%23ffffff'>SDG</text></svg>" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | Edo State NYSC SDG CDS</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#006633" />
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  </head>
  <body class="min-h-full flex flex-col bg-slate-50 text-slate-900">
    <Navbar />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
